---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import PhotoGrid from '../components/gallery/PhotoGrid.astro';
import { getGalleryImage, getGalleryAlbumImages } from '../lib/media';

interface Props {
  locale: 'en' | 'zh';
  slug: string;
  title: string;
}

const { locale, slug, title } = Astro.props;
const site = await getEntry('site', `main-${locale}`);
const { eyebrow, intro } = site!.data.gallery;
const { backLabel } = site!.data.nav;

const heroImage = getGalleryImage('hero');
const images = getGalleryAlbumImages(slug);
---

<BaseLayout title={`${title} — Noah Wen`} description={intro}>
  <div class="gallery-album__back">
    <BackLink label={backLabel} href={`/${locale}/gallery`} />
  </div>
  <section class="gallery-album">
    <div class="gallery-album__hero">
      <div class="gallery-album__hero-illustration">
        <Media image={heroImage} ratio="159/436" alt={`${title} illustration`} loading="eager" />
      </div>
      <SectionIntro eyebrow={eyebrow} headline={title} body={intro} />
    </div>

    <PhotoGrid images={images} labelPrefix={title} />
  </section>
</BaseLayout>

<style>
  /* 返回鍵是全域導覽元件，對齊 Nav 的滿版 padding，跟案例頁同一條線 */
  .gallery-album__back {
    padding: var(--sp-3) var(--sp-3) 0;
  }

  .gallery-album {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .gallery-album__hero {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .gallery-album__hero :global(.section-intro) {
    margin-bottom: 0;
  }

  .gallery-album__hero-illustration {
    flex: none;
    width: 160px;
  }

  .gallery-album__hero-illustration :global(.media) {
    border-radius: 0;
  }

  @media (max-width: 767px) {
    .gallery-album__hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
