---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import PhotoMarquee from '../components/gallery/PhotoMarquee.astro';
import { getGalleryImage, getGalleryAlbumImages } from '../lib/media';

interface Props {
  locale: 'en' | 'zh';
  slug: string;
  title: string;
}

const { locale, slug, title } = Astro.props;
const site = await getEntry('site', `main-${locale}`);
const gallery = site!.data.gallery;
const { backLabel } = site!.data.nav;

/*
  引言與說明優先用這個相簿自己的。先前一律讀 gallery 那一組，所以每個相簿頁都顯示
  同一句 eyebrow 和同一段「介紹全部相簿」的長文——在單一相簿頁上讀起來像放錯了。

  兩個欄位都是選填，沒填就退回 gallery 的那組，頁面不會開天窗。
*/
const album = [...gallery.albums, gallery.germany].find((a) => a.slug === slug);
const eyebrow = album?.eyebrow ?? gallery.eyebrow;
const intro = album?.intro ?? gallery.intro;

const heroImage = getGalleryImage('hero');
const images = getGalleryAlbumImages(slug);
---

<BaseLayout title={`${title} — Noah Wen`} description={intro}>
  <div class="gallery-album__back">
    <BackLink label={backLabel} href={`/${locale}/gallery`} />
  </div>
  <section class="gallery-album">
    <div class="gallery-album__hero" data-reveal>
      <div class="gallery-album__hero-illustration">
        <Media image={heroImage} ratio="159/436" alt={`${title} illustration`} loading="eager" />
      </div>
      <SectionIntro eyebrow={eyebrow} headline={title} body={intro} />
    </div>

    <div data-reveal>
      <PhotoMarquee images={images} labelPrefix={title} />
    </div>
  </section>
</BaseLayout>

<style>
  /* 返回鍵是全域導覽元件，對齊 Nav 的滿版 padding，跟案例頁同一條線 */
  .gallery-album__back {
    max-width: var(--content-width);
    margin: 0 auto;
    /*
      上下內距對稱。原本下方是 0，返回鍵整個貼在容器底部——上面有空、下面沒有，
      按鈕看起來就不是置中的。當初設 0 是為了讓下方的 hero 緊接著，
      但那讓返回鍵自己站得很奇怪，24px 的呼吸空間值得。
    */
    padding: var(--sp-3) var(--content-gutter);
  }

  .gallery-album {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-7) var(--content-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .gallery-album__hero {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
  }

  .gallery-album__hero :global(.section-intro) {
    margin-bottom: 0;
  }

  .gallery-album__hero-illustration {
    flex: none;
    width: var(--hero-illustration-width);
  }

  .gallery-album__hero-illustration :global(.media) {
    border-radius: 0;
  }

  @media (max-width: 767px) {
    .gallery-album__hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
