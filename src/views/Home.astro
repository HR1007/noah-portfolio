---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import PullQuote from '../components/PullQuote.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ConnectChannel from '../components/ConnectChannel.astro';
import { getHomeImage, getHomeImageSet } from '../lib/media';

interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const site = await getEntry('site', `main-${locale}`);
const { home } = site!.data;

const heroImage = getHomeImage('hero');
const avatarImage = getHomeImage('avatar');
const aboutImage = getHomeImage('about');
const hobbyPhotos = getHomeImageSet('hobby');
---

<BaseLayout
  title={`${home.heroName} — ${home.heroRoles[0]}`}
  description={home.aboutIntro}
>
  <section class="hero">
    <div class="hero__media">
      <Media image={heroImage} ratio="157/378" alt={`${home.heroName} pixel-art portrait`} />
    </div>
    <ul class="hero__roles">
      {home.heroRoles.map((role) => <li>{role}</li>)}
    </ul>
  </section>

  <section class="quote">
    <PullQuote quote={home.heroQuote} />
    <div class="quote__byline">
      <div class="quote__avatar">
        <Media image={avatarImage} ratio="1/1" alt={home.heroName} />
      </div>
      <div>
        <p class="quote__name">{home.heroName}</p>
        <p class="quote__tagline">{home.heroTagline}</p>
      </div>
    </div>
  </section>

  <section class="about">
    <h2 class="about__heading">{home.aboutHeading}</h2>
    <div class="about__grid">
      <Media image={aboutImage} ratio="483/342" alt={home.heroName} />
      <div>
        <h3 class="about__subheading">{home.aboutSubheading}</h3>
        <p class="about__intro">{home.aboutIntro}</p>
      </div>
    </div>
  </section>

  <section class="beyond-grid">
    <div class="beyond-grid__text">
      <h2>{home.beyondGridHeading}</h2>
      {home.beyondGridParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      hobbyPhotos.length > 0 && (
        <div class="beyond-grid__hobbies">
          {hobbyPhotos.map((photo, index) => (
            <Media image={photo} ratio="1/1" alt={`travel photo ${index + 1}`} />
          ))}
        </div>
      )
    }
  </section>

  <section class="experience">
    {home.experience.map((item) => (
      <ExperienceItem title={item.title} period={item.period} description={item.description} />
    ))}
  </section>

  <section class="connect">
    <h2>{home.connectHeading}</h2>
    <div class="connect__intro">
      {home.connectIntro.map((line) => <p>{line}</p>)}
    </div>
    <div class="connect__channels">
      {home.connectChannels.map((channel) => (
        <ConnectChannel
          icon={channel.icon}
          label={channel.label}
          value={channel.value}
          href={channel.href}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-3);
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: var(--sp-3);
  }

  .hero__media {
    width: min(100%, 157px);
    margin-bottom: var(--sp-3);
  }

  .hero__roles {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-body-lg);
  }

  .quote {
    padding-top: var(--sp-3);
    padding-bottom: var(--sp-7);
  }

  .quote__byline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .quote__avatar {
    width: 56px;
    flex: none;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .quote__name {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-semibold);
    text-align: left;
  }

  .quote__tagline {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-align: left;
  }

  .about {
    border-top: 1px solid var(--color-border);
  }

  .about__heading {
    font-size: var(--font-size-hero);
    line-height: 0.95;
    margin-bottom: var(--sp-4);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--sp-5);
    align-items: start;
  }

  .about__subheading {
    font-size: var(--font-size-h2);
    margin-bottom: var(--sp-2);
  }

  .about__intro {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }

  .beyond-grid {
    border-top: 1px solid var(--color-border);
  }

  .beyond-grid__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    color: var(--color-muted);
    font-size: var(--font-size-body);
    line-height: 1.7;
    margin-bottom: var(--sp-5);
  }

  .beyond-grid__text h2 {
    color: var(--color-ink);
  }

  .beyond-grid__hobbies {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2);
  }

  .connect {
    text-align: center;
  }

  .connect h2 {
    margin-bottom: var(--sp-2);
  }

  .connect__intro {
    color: var(--color-muted);
    margin-bottom: var(--sp-4);
  }

  .connect__channels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    text-align: left;
    max-width: 560px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .about__grid,
    .connect__channels {
      grid-template-columns: 1fr;
    }

    .beyond-grid__hobbies {
      grid-template-columns: repeat(2, 1fr);
    }

    .about__heading {
      font-size: var(--font-size-h1);
    }
  }
</style>
