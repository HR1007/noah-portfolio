---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import Placeholder from '../components/Placeholder.astro';
import PullQuote from '../components/PullQuote.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ConnectChannel from '../components/ConnectChannel.astro';
import ReadMore from '../components/ReadMore.astro';
import ScrollVideo from '../components/ScrollVideo.astro';
import SectionNav from '../components/project/SectionNav.astro';
import { getHomeImage, getHomeImageSet, getHomeVideo } from '../lib/media';

interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const site = await getEntry('site', `main-${locale}`);
const { home } = site!.data;

const heroImage = getHomeImage('hero');
const avatarImage = getHomeImage('avatar');
const aboutImage = getHomeImage('about');
const hobbyPhotos = getHomeImageSet('hobby');
const reachVideo = getHomeVideo('character-reach');
const reachPoster = getHomeImage('character-reach-poster');

/*
  側邊章節導覽項目，跟案例頁（ProjectDetail.astro）用同一顆 SectionNav、同一條規則：
  只收有標題文字的段落，才有東西可以當目錄的字。hero／quote／捲動影片都沒有標題
  （案例頁的 hero 同樣不列入 navItems），略過。
*/
const navItems = [
  { id: 'about', label: home.aboutHeading },
  { id: 'beyond-grid', label: home.beyondGridHeading },
  { id: 'activities', label: home.activitiesHeading },
  { id: 'connect', label: home.connectHeading },
];
---

<BaseLayout
  title={`${home.heroName} — ${home.heroRoles[0]}`}
  description={home.aboutIntro}
>
  {/*
    捲動驅動的伸手互動：貼在頂欄正下方，訪客一進站先看到這個。往下捲，角色慢慢把手
    伸向螢幕；往回捲就縮回去，停下就停在當下那一幀。獨立一個滿版 section，不透明、
    不疊加任何內容——細節見 ScrollVideo.astro。

    裝飾用取景框角標＋捲動提示：純圖示、不含文字（文案要走 content，這兩個是裝飾
    不是文案）。角標讓滿版影片有個「畫面邊界」而不是隨機被裁切的一塊，呼應本人是
    做人因工程／手勢互動研究的背景；捲動提示只在剛進站、還沒開始捲的時候看得到——
    使用者一開始捲，捲動舞台本身就是最清楚的提示，這顆圖示的任務就結束了。
  */}
  {reachVideo && (
    <ScrollVideo src={reachVideo} ratio="1280/654" poster={reachPoster?.src}>
      {/*
        取景框：呼應「觀景窗」的概念——角色像是被鏡頭注視著，同時也在注視訪客。
        網格格距用 --sp-6（8 的 8 倍）不是隨手選的：首頁引言那句「My life is an
        8px grid」就是本人自己的梗，格線放大 8 倍剛好在滿版尺度上看得出來是格線，
        又還是同一套間距階梯，不是另外發明的數字。
      */}
      <div class="reach-frame">
        <div class="reach-frame__grid" />
        <span class="reach-frame__corner reach-frame__corner--tl" aria-hidden="true" />
        <span class="reach-frame__corner reach-frame__corner--tr" aria-hidden="true" />
        <span class="reach-frame__corner reach-frame__corner--bl" aria-hidden="true" />
        <span class="reach-frame__corner reach-frame__corner--br" aria-hidden="true" />
        {/*
          錄製中的提示點＋一句招呼：暗示「這一段正在被記錄、角色注意到你了」，呼應
          觀景窗的概念。文字來自 home.reachCaption，不是裝飾圖形，所以不掛 aria-hidden——
          螢幕閱讀器唸得到，這句招呼才不會只有看得到畫面的人收到。
        */}
        <div class="reach-frame__rec">
          <span class="reach-frame__rec-dot" aria-hidden="true" />
          <span class="reach-frame__rec-label">{home.reachCaption}</span>
        </div>
        {/*
          像素貼圖：呼應首頁 hero 本來就有的像素風插畫（hero.png），手繪的一顆像素愛心，
          不是另外生成的圖檔——SVG rect 畫格子，縮放不失真，也不用多帶一個圖片請求。
        */}
        <svg class="reach-frame__sticker" viewBox="0 0 7 6" aria-hidden="true">
          <rect x="1" y="0" width="2" height="1" />
          <rect x="4" y="0" width="2" height="1" />
          <rect x="0" y="1" width="7" height="1" />
          <rect x="0" y="2" width="7" height="1" />
          <rect x="1" y="3" width="5" height="1" />
          <rect x="2" y="4" width="3" height="1" />
          <rect x="3" y="5" width="1" height="1" />
        </svg>
        {/* 中央準星：呼應本人做手勢互動／AR 介面研究的背景，緩緩呼吸，暗示鏡頭正對準訪客 */}
        <span class="reach-frame__reticle" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <circle cx="24" cy="24" r="13" />
            <path d="M24 2v9M24 37v9M2 24h9M37 24h9" />
          </svg>
        </span>
        <span class="reach-frame__cue" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></svg>
        </span>
      </div>
    </ScrollVideo>
  )}

  <section class="hero">
    <div class="hero__media">
      <Media image={heroImage} ratio="157/378" alt={`${home.heroName} pixel-art portrait`} />
    </div>
    <ul class="hero__roles">
      {home.heroRoles.map((role) => <li>{role}</li>)}
    </ul>
  </section>

  <section class="quote">
    <PullQuote quote={home.heroQuote} />
    <div class="quote__byline">
      <div class="quote__avatar">
        <Media image={avatarImage} ratio="1/1" alt={home.heroName} />
      </div>
      <div>
        <p class="quote__name">{home.heroName}</p>
        <p class="quote__tagline">{home.heroTagline}</p>
      </div>
    </div>
  </section>

  <section class="about" id="about">
    <h2 class="about__heading">{home.aboutHeading}</h2>
    <div class="about__grid">
      <div
        class="about__photo"
        style={aboutImage ? `aspect-ratio:${aboutImage.width}/${aboutImage.height}; max-height:${aboutImage.height}px` : undefined}
      >
        {
          aboutImage ? (
            <Image src={aboutImage} alt={home.heroName} />
          ) : (
            <Placeholder ratio="4/5" label={home.heroName} />
          )
        }
      </div>
      <div>
        <h3 class="about__subheading">{home.aboutSubheading}</h3>
        {/* 兩欄版面下這一段特別高，收合後照片與文字的高度才不會差太多 */}
        <ReadMore lines={6}>
          <p class="about__intro">{home.aboutIntro}</p>
          <p class="about__intro">{home.aboutResearch}</p>
        </ReadMore>
      </div>
    </div>
  </section>

  <section class="beyond-grid" id="beyond-grid">
    <div class="beyond-grid__text">
      <h2>{home.beyondGridHeading}</h2>
      {home.beyondGridParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      hobbyPhotos.length > 0 && (
        <div class="beyond-grid__hobbies">
          {hobbyPhotos.map((photo, index) => (
            <Media image={photo} ratio="1/1" alt={`travel photo ${index + 1}`} />
          ))}
        </div>
      )
    }
  </section>

  <section class="experience">
    {home.experience.map((item) => (
      <ExperienceItem title={item.title} period={item.period} description={item.description} />
    ))}
  </section>

  {/*
    研討會與服務。跟上面的工作經歷用同一個 ExperienceItem，只是多一個標題把兩類分開——
    工作經歷是「受僱做什麼」，這一區是「主動參與了什麼」，混在一起讀者分不出來。
  */}
  <section class="activities" id="activities">
    <h2 class="activities__heading">{home.activitiesHeading}</h2>
    {home.activities.map((item) => (
      <ExperienceItem title={item.title} period={item.period} description={item.description} />
    ))}
  </section>

  <section class="connect" id="connect">
    <h2>{home.connectHeading}</h2>
    <div class="connect__intro">
      {home.connectIntro.map((line) => <p>{line}</p>)}
    </div>
    <div class="connect__channels">
      {home.connectChannels.map((channel) => (
        <ConnectChannel
          icon={channel.icon}
          label={channel.label}
          value={channel.value}
          href={channel.href}
        />
      ))}
    </div>
  </section>

  <SectionNav items={navItems} toTopLabel={site!.data.nav.toTop} />
</BaseLayout>

<style>
  section {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-7) var(--content-gutter);
  }

  /*
    頂欄正下方伸手影片的裝飾層：觀景窗角標、細格線、錄製提示＋招呼文字、像素貼圖、
    中央準星、捲動提示。全部用 --color-on-hero——那個 token 就是為「疊在照片／背景圖
    上的標記，深色模式不跟著翻」而設的，跟這裡的用途完全一致（影片本身不隨主題反轉，
    疊在上面的裝飾也不該反轉）。.reach-frame 這層先內縮 --sp-3，角標跟著貼在它的邊界，
    不用每個角再各自重複一次內縮值。
  */
  .reach-frame {
    position: absolute;
    inset: var(--sp-3);
    color: var(--color-on-hero);
  }

  /*
    細格線。格距用 --sp-6（8 的 8 倍）——首頁引言那句「My life is an 8px grid」
    是本人自己的梗，格線放大 8 倍剛好在滿版尺度上看得出來是格線，又還是同一套
    間距階梯，不是另外發明的數字。
  */
  .reach-frame__grid {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(to right, currentColor 0 1px, transparent 1px var(--sp-6)),
      repeating-linear-gradient(to bottom, currentColor 0 1px, transparent 1px var(--sp-6));
    opacity: 0.08;
  }

  .reach-frame__corner {
    position: absolute;
    width: var(--sp-4);
    height: var(--sp-4);
    border-color: currentColor;
    border-style: solid;
    border-width: 0;
  }

  .reach-frame__corner--tl {
    top: 0;
    left: 0;
    border-top-width: 1px;
    border-left-width: 1px;
  }

  .reach-frame__corner--tr {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }

  .reach-frame__corner--bl {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }

  .reach-frame__corner--br {
    bottom: 0;
    right: 0;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  /* 錄製提示點＋招呼文字，貼在左上角標旁邊 */
  .reach-frame__rec {
    position: absolute;
    top: var(--sp-2);
    left: var(--sp-2);
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .reach-frame__rec-dot {
    flex: none;
    width: var(--sp-1);
    height: var(--sp-1);
    border-radius: var(--radius-pill);
    background: currentColor;
    animation: reach-rec-pulse 1.8s var(--motion-ease) infinite;
  }

  .reach-frame__rec-label {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @keyframes reach-rec-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* 像素愛心貼圖，貼在右上角標旁邊，跟左上的錄製提示左右呼應 */
  .reach-frame__sticker {
    position: absolute;
    top: var(--sp-2);
    right: var(--sp-2);
    width: var(--sp-4);
    height: auto;
    fill: currentColor;
    shape-rendering: crispEdges;
  }

  /* 中央準星：緩緩呼吸，暗示鏡頭正對準訪客 */
  .reach-frame__reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--sp-6);
    height: var(--sp-6);
    animation: reach-reticle-pulse 2.4s var(--motion-ease) infinite;
  }

  .reach-frame__reticle svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  @keyframes reach-reticle-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: translate(-50%, -50%) scale(0.92);
    }
    50% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* 捲動提示：靜置時輕輕上下彈，暗示「這裡可以捲」 */
  .reach-frame__cue {
    position: absolute;
    bottom: var(--sp-2);
    left: 50%;
    animation: reach-cue-bounce 1.6s var(--motion-ease) infinite;
  }

  .reach-frame__cue svg {
    width: var(--icon-lg);
    height: var(--icon-lg);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes reach-cue-bounce {
    0%,
    100% {
      transform: translate(-50%, 0);
    }
    50% {
      transform: translate(-50%, var(--sp-1));
    }
  }

  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: var(--sp-3);
  }

  .hero__media {
    width: min(100%, var(--home-hero-width));
    margin-bottom: var(--sp-3);
  }

  /* 透明去背的插畫沒有矩形底，圓角只會裁掉碰到邊角的圖案（鞋子、頭髮） */
  .hero__media :global(.media) {
    border-radius: 0;
  }

  .hero__roles {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    font-weight: var(--font-weight-medium);
    font-size: var(--font-size-body-lg);
  }

  .quote {
    padding-top: var(--sp-3);
    padding-bottom: var(--sp-7);
  }

  .quote__byline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
  }

  .quote__avatar {
    width: var(--avatar-size);
    flex: none;
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .quote__name {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-medium);
    text-align: left;
  }

  .quote__tagline {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    text-align: left;
  }

  /*
    scroll-margin-top：導覽列是 sticky 的，不留這段空白，側邊導覽跳過去之後
    段落標題會被蓋住。數值跟案例頁的 .project-anchor 用同一個 token（--sp-7），
    是側邊導覽（SectionNav）這個元件在本站的固定搭配值，不是這裡另外調的。
  */
  .about,
  .beyond-grid,
  .activities,
  .connect {
    scroll-margin-top: var(--sp-7);
  }

  .about {
    border-top: 1px solid var(--color-border);
  }

  .about__heading {
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-light);
    line-height: 0.95;
    margin-bottom: var(--sp-4);
  }

  /*
    .about__photo 用行內 style 帶入圖片原始寬高比（aspect-ratio）與原始像素高度
    （max-height），讓 Grid 在 auto-track 階段就能算出寬度，避免其寬度依賴
    尚未 resolve 的 stretch 高度造成的循環相依（img width:auto + height:100% 會讓寬度塌陷為 0）。
    文字比較長時，欄位會被 align-items:stretch 撐到跟文字一樣高，但不會超過
    max-height（原始像素高度），所以不會被放大過原始解析度；文字比較短時，
    照片維持自己的原始比例與高度，不強制裁切。
  */
  .about__grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-5);
    align-items: stretch;
  }

  .about__photo {
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .about__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .about__subheading {
    font-size: var(--font-size-h2);
    margin-bottom: var(--sp-2);
  }

  /* 兩段之間要有間距，收合時看起來才是「還有下一段」而不是斷掉 */
  .about__intro + .about__intro {
    margin-top: var(--sp-2);
  }

  .about__intro {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }

  .beyond-grid {
    border-top: 1px solid var(--color-border);
  }

  .beyond-grid__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    color: var(--color-muted);
    font-size: var(--font-size-body);
    line-height: 1.7;
    margin-bottom: var(--sp-5);
  }

  .beyond-grid__text h2 {
    color: var(--color-ink);
  }

  .beyond-grid__hobbies {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2);
  }

  .activities {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--content-gutter) var(--sp-7);
  }

  .activities__heading {
    font-size: var(--font-size-h2);
    margin-bottom: var(--sp-3);
  }

  .connect {
    text-align: center;
  }

  .connect h2 {
    margin-bottom: var(--sp-2);
  }

  .connect__intro {
    color: var(--color-muted);
    margin-bottom: var(--sp-4);
  }

  /*
    改用置中的 flex 而不是固定欄數的格線：管道從兩個變三個之後，1fr 1fr 會讓
    第三個落單在第二列左邊，看起來像漏了一個。flex 讓它們依實際寬度排在一列，
    放不下時整排往下折並維持置中，加第四個也不用再改欄數。
  */
  .connect__channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3) var(--sp-5);
    text-align: left;
    max-width: var(--connect-grid-width);
    margin: 0 auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .reach-frame__cue,
    .reach-frame__reticle,
    .reach-frame__rec-dot {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    /* 手機上一個一列，靠左對齊比置中好讀（值的長度差很多） */
    .connect__channels {
      flex-direction: column;
      align-items: flex-start;
      width: fit-content;
    }

    .beyond-grid__hobbies {
      grid-template-columns: repeat(2, 1fr);
    }

    .about__heading {
      font-size: var(--font-size-h1);
    }
  }
</style>
