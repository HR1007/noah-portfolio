---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import Media from '../components/Media.astro';
import { getProjectImages, getPortfolioImage } from '../lib/media';
import { t } from '../lib/i18n';

interface Props {
  locale: 'en' | 'zh';
}

const { locale } = Astro.props;
const site = await getEntry('site', `main-${locale}`);
const { eyebrow, headline, intro } = site!.data.portfolio;

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const heroImage = getPortfolioImage('hero');
---

<BaseLayout title={`${headline} — Noah Wen`} description={intro}>
  <section class="portfolio">
    <div class="portfolio__hero" data-reveal>
      {
        heroImage && (
          <div class="portfolio__hero-illustration">
            <Media
              image={heroImage}
              ratio={`${heroImage.width}/${heroImage.height}`}
              alt={`${headline} illustration`}
              loading="eager"
            />
          </div>
        )
      }
      <SectionIntro eyebrow={eyebrow} headline={headline} body={intro} />
    </div>
    <div class="portfolio__list" data-reveal>
      {
        /*
          第一順位的案例獨立一整排、視覺放大（featured），呼應它被排到第一順位
          這個決定——第一眼看到的不只是排序在前，視覺上也確實是「開場作品」。
          其餘案例固定圖左文右，不左右交錯——交錯會讓文字欄的左邊界在「貼齊頁面
          左緣」與「貼齊圖片右側的內緣」之間跳來跳去，往下捲動時讀起來像沒對齊。
        */
        projects.map((project, index) => (
          <PortfolioCard
            title={t(project.data.title, locale)}
            summary={t(project.data.summary, locale)}
            ctaLabel={t(project.data.ctaLabel, locale)}
            href={`/${locale}/projects/${project.id}`}
            image={getProjectImages(project.id)[0]}
            featured={index === 0}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-7) var(--content-gutter);
  }

  .portfolio__hero {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    margin-bottom: var(--sp-6);
  }

  .portfolio__hero :global(.section-intro) {
    margin-bottom: 0;
  }

  .portfolio__hero-illustration {
    flex: none;
    width: var(--hero-illustration-width);
  }

  .portfolio__hero-illustration :global(.media) {
    border-radius: 0;
  }

  .portfolio__list {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 767px) {
    .portfolio__hero {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
