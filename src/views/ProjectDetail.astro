---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import TextSection from '../components/project/TextSection.astro';
import DeviceShowcase from '../components/project/DeviceShowcase.astro';
import ExperienceDemo from '../components/project/ExperienceDemo.astro';
import FeatureSplit from '../components/project/FeatureSplit.astro';
import FeatureGrid from '../components/project/FeatureGrid.astro';
import ImageRow from '../components/project/ImageRow.astro';
import IllustrationGrid from '../components/project/IllustrationGrid.astro';
import ResearchFramework from '../components/project/ResearchFramework.astro';
import Persona from '../components/project/Persona.astro';
import DesignThemes from '../components/project/DesignThemes.astro';
import Flow from '../components/project/Flow.astro';
import ProjectQuote from '../components/project/ProjectQuote.astro';
import { getProjectImageMap } from '../lib/media';
import { t, type LocalizedText } from '../lib/i18n';
import SectionNav from '../components/project/SectionNav.astro';
import { assignImages } from '../lib/image-slots.mjs';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: 'en' | 'zh';
}

const { project, locale } = Astro.props;
const { hero, sections } = project.data;
const isMigrated = hero !== undefined && sections.length > 0;

const site = await getEntry('site', `main-${locale}`);
const { projectQuote } = site!.data;
const { backLabel } = site!.data.nav;

// 圖片不寫路徑/檔名在內容裡：依區塊在頁面上出現的順序，依序從該專案資料夾取圖。
// 版位規則集中在 lib/image-slots.mjs，後台顯示「第 N 格是哪個區塊」也是讀同一支，
// 兩邊不會各自算一套而失去同步。資料夾沒圖時取值為 undefined，Media 會顯示佔位框。
const images = getProjectImageMap(project.id);
const { hero: heroImage, bySection } = assignImages(project.data, images);
const imagesFor = (i: number) => bySection[i] ?? [];

/*
  這一頁所有「給人看的文字」都經過這裡取值：欄位還是純字串就原樣回傳，
  已經雙語化的就依 locale 取，zh 沒填時退回 en（見 lib/i18n 的 t）。
  ratio／layout／direction／ctaHref 不經過——那些不是給人讀的。
*/
const tr = (v: LocalizedText | undefined) => t(v, locale);
const trReq = (v: LocalizedText) => t(v, locale);

// 陣列型欄位裡的文字也要逐項取值，其餘設定原樣帶過
const trAlt = <T extends { alt: LocalizedText }>(items: T[]) =>
  items.map((item) => ({ ...item, alt: trReq(item.alt) }));
const trColumns = (
  cols: { heading: LocalizedText; body: LocalizedText; ratio: string; alt: LocalizedText }[]
) => cols.map((c) => ({ ...c, heading: trReq(c.heading), body: trReq(c.body), alt: trReq(c.alt) }));
const trThemes = (themes: { title: LocalizedText; description?: LocalizedText }[]) =>
  themes.map((x) => ({ ...x, title: trReq(x.title), description: tr(x.description) }));

/*
  側邊章節導覽的項目。優先用 eyebrow（那是這一段的分類名，最短也最像目錄），
  沒有就退回 heading；兩個都沒有的段落（例如純圖的 deviceShowcase）不列入——
  目錄裡出現一個沒有名字的項目，比少一個項目更糟。
*/
const navItems = sections
  .map((section, i) => {
    const label = tr((section as { eyebrow?: LocalizedText }).eyebrow)
      ?? tr((section as { heading?: LocalizedText }).heading);
    return label ? { id: `sec-${i}`, label } : null;
  })
  .filter((x): x is { id: string; label: string } => x !== null);

const { Content } = await render(project);
---

<BaseLayout title={`${trReq(project.data.title)} — Noah Wen`} description={trReq(project.data.summary)}>
  <div class="project-back">
    <BackLink label={backLabel} href={`/${locale}/portfolio`} />
  </div>
  {
    isMigrated ? (
      <Fragment>
        <ProjectHero
          title={trReq(project.data.title)}
          ctaLabel={trReq(hero!.ctaLabel)}
          ctaHref={hero!.ctaHref}
          image={heroImage}
        />

        {sections.map((section, sectionIndex) => {
          /*
            包一層只帶 id 的容器當錨點。不直接在十一個段落元件上各加一個 id prop，
            那要改十一個檔案，而且 id 是「這一頁怎麼被導覽」的事，不是元件自己的事。
            這層 div 沒有樣式，不會動到段落元件自己的版面。
          */
          const anchor = (node: unknown) => (
            <div class="project-anchor" id={`sec-${sectionIndex}`}>{node}</div>
          );
          switch (section.type) {
            case 'textSection':
              return anchor(
                <TextSection
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  paragraphs={section.paragraphs.map(trReq)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'deviceShowcase':
              return anchor(<DeviceShowcase
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={trReq(section.alt)}
                  eyebrow={tr(section.eyebrow)}
                  heading={tr(section.heading)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />);
            case 'experienceDemo':
              return anchor(
                <ExperienceDemo
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  body={tr(section.body)}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={trReq(section.alt)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                  layout={section.layout}
                />
              );
            case 'featureSplit':
              return anchor(
                <FeatureSplit
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  body={tr(section.body)}
                  imagePosition={section.imagePosition}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={trReq(section.alt)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'featureGrid':
              return anchor(
                <FeatureGrid
                  eyebrow={tr(section.eyebrow)}
                  heading={tr(section.heading)}
                  columns={trColumns(section.columns)}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'imageRow':
              return anchor(
                <ImageRow
                  rows={trAlt(section.images)}
                  images={imagesFor(sectionIndex)}
                  eyebrow={tr(section.eyebrow)}
                  heading={tr(section.heading)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'illustrationGrid':
              return anchor(
                <IllustrationGrid
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  body={tr(section.body)}
                  alt={trReq(section.alt)}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'researchFramework':
              return anchor(
                <ResearchFramework
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  paragraphs={section.paragraphs.map(trReq)}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={trReq(section.alt)}
                  layout={section.layout}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'persona':
              return anchor(
                <Persona
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  personas={trAlt(section.personas)}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'designThemes':
              return anchor(
                <DesignThemes
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  themes={trThemes(section.themes)}
                  direction={section.direction}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            case 'flow':
              return anchor(
                <Flow
                  eyebrow={tr(section.eyebrow)}
                  heading={trReq(section.heading)}
                  body={tr(section.body)}
                  steps={trAlt(section.steps)}
                  direction={section.direction}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={tr(section.ctaLabel)}
                  ctaHref={section.ctaHref}
                />
              );
            default:
              return null;
          }
        })}

        <ProjectQuote quote={projectQuote.quote} name={projectQuote.name} tagline={projectQuote.tagline} />
        <SectionNav items={navItems} toTopLabel={site!.data.nav.toTop} />
      </Fragment>
    ) : (
      <Fragment>
        <section class="project-hero">
          <h1 class="project-hero__title">{trReq(project.data.title)}</h1>
          <p class="project-hero__summary">{trReq(project.data.summary)}</p>
        </section>

        <section class="project-showcase">
          <Media image={images[0]} ratio="4/3" alt={`${trReq(project.data.title)} showcase`} />
        </section>

        <section class="project-body">
          <Content />
        </section>
      </Fragment>
    )
  }
</BaseLayout>

<style>
  /*
    章節錨點。scroll-margin-top 是必要的——導覽列是 sticky 的，
    不留這段空白，跳過去之後段落標題會被導覽列蓋住。
  */
  .project-anchor {
    scroll-margin-top: var(--sp-7);
  }

  /* 返回鍵是全域導覽元件，對齊 Nav 的滿版 padding，而非各區塊寬度不一的內容欄 */
  .project-back {
    padding: var(--sp-3) var(--sp-3) 0;
  }

  .project-hero,
  .project-showcase,
  .project-body {
    max-width: var(--prose-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--sp-2);
  }

  .project-hero__summary {
    font-size: var(--font-size-body-lg);
    color: var(--color-muted);
    max-width: 65ch;
  }

  .project-body {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
