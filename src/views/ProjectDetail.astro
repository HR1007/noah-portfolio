---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import ProjectSection from '../components/project/ProjectSection.astro';
import Changelog from '../components/project/Changelog.astro';
import ProjectQuote from '../components/project/ProjectQuote.astro';
import { getProjectImageMap, getProjectVideoMap, getDeviceShowcaseDarkImage } from '../lib/media';
import { t, type LocalizedText } from '../lib/i18n';
import SectionNav from '../components/project/SectionNav.astro';
import { assignImages } from '../lib/image-slots.mjs';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: 'en' | 'zh';
}

const { project, locale } = Astro.props;
const { hero, sections, changelog } = project.data;
const isMigrated = hero !== undefined && sections.length > 0;

const site = await getEntry('site', `main-${locale}`);
const { projectQuote } = site!.data;
const { backLabel } = site!.data.nav;

// 圖片不寫路徑/檔名在內容裡：依區塊在頁面上出現的順序，依序從該專案資料夾取圖。
// 版位規則集中在 lib/image-slots.mjs，後台顯示「第 N 格是哪個區塊」也是讀同一支，
// 兩邊不會各自算一套而失去同步。資料夾沒圖時取值為 undefined，Media 會顯示佔位框。
const images = getProjectImageMap(project.id);
const { hero: heroImage, bySection, byChangelog } = assignImages(project.data, images);
const imagesFor = (i: number) => bySection[i] ?? [];
const deviceShowcaseDarkImage = getDeviceShowcaseDarkImage(project.id);

/*
  版位影片（目前只有 experienceDemo 用得到）。assignImages 本身跟圖片的型別
  無關，只是純粹的版位編號查表，所以直接餵進 getProjectVideoMap 的結果，
  一樣會得到跟圖片版位完全對齊的 bySection——某個版位到底有沒有影片，
  是呼叫端（下面的 experienceDemo case）自己決定要不要優先用，兩份表不互相干涉。
*/
const { bySection: videoBySection } = assignImages(project.data, getProjectVideoMap(project.id));
const videoFor = (i: number) => videoBySection[i]?.[0];

/*
  這一頁所有「給人看的文字」都經過這裡取值：欄位還是純字串就原樣回傳，
  已經雙語化的就依 locale 取，zh 沒填時退回 en（見 lib/i18n 的 t）。
  ratio／layout／direction／ctaHref 不經過——那些不是給人讀的。
*/
const tr = (v: LocalizedText | undefined) => t(v, locale);
const trReq = (v: LocalizedText) => t(v, locale);

/*
  側邊章節導覽的項目。優先用 eyebrow（那是這一段的分類名，最短也最像目錄），
  沒有就退回 heading；兩個都沒有的段落（例如純圖的 deviceShowcase）不列入——
  目錄裡出現一個沒有名字的項目，比少一個項目更糟。
*/
const navItems = sections
  .map((section, i) => {
    const label = tr((section as { eyebrow?: LocalizedText }).eyebrow)
      ?? tr((section as { heading?: LocalizedText }).heading);
    return label ? { id: `sec-${i}`, label } : null;
  })
  .filter((x): x is { id: string; label: string } => x !== null);

// 更新日誌也列進側邊導覽（排在最後），收合著的區塊才找得到
const CHANGELOG_ID = 'changelog';
if (changelog.length > 0) navItems.push({ id: CHANGELOG_ID, label: site!.data.changelog.eyebrow });

const { Content } = await render(project);
---

<BaseLayout title={`${trReq(project.data.title)} — Noah Wen`} description={trReq(project.data.summary)}>
  <div class="project-back">
    <BackLink label={backLabel} href={`/${locale}/portfolio`} />
  </div>
  {
    isMigrated ? (
      <Fragment>
        <ProjectHero
          title={trReq(project.data.title)}
          ctaLabel={trReq(hero!.ctaLabel)}
          ctaHref={hero!.ctaHref}
          image={heroImage}
        />

        {sections.map((section, sectionIndex) => (
          /*
            包一層只帶 id 的容器當錨點。不直接在每個段落元件上各加一個 id prop，
            id 是「這一頁怎麼被導覽」的事，不是元件自己的事。
            這層 div 沒有樣式，不會動到段落元件自己的版面。
          */
          <div class="project-anchor" id={`sec-${sectionIndex}`}>
            <ProjectSection
              section={section}
              locale={locale}
              images={imagesFor(sectionIndex)}
              video={videoFor(sectionIndex)}
              imageDark={section.type === 'deviceShowcase' ? deviceShowcaseDarkImage : undefined}
            />
          </div>
        ))}

        {changelog.length > 0 && (
          <div class="project-anchor" id={CHANGELOG_ID}>
            <Changelog
              headingId={`${CHANGELOG_ID}-heading`}
              eyebrow={site!.data.changelog.eyebrow}
              heading={site!.data.changelog.heading}
              entries={changelog}
              images={byChangelog}
              locale={locale}
            />
          </div>
        )}

        <ProjectQuote quote={projectQuote.quote} name={projectQuote.name} tagline={projectQuote.tagline} />
        <SectionNav items={navItems} toTopLabel={site!.data.nav.toTop} />
      </Fragment>
    ) : (
      <Fragment>
        <section class="project-hero">
          <h1 class="project-hero__title">{trReq(project.data.title)}</h1>
          <p class="project-hero__summary">{trReq(project.data.summary)}</p>
        </section>

        <section class="project-showcase">
          <Media image={images[0]} ratio="4/3" alt={`${trReq(project.data.title)} showcase`} />
        </section>

        <section class="project-body">
          <Content />
        </section>
      </Fragment>
    )
  }
</BaseLayout>

<style>
  /*
    章節錨點。scroll-margin-top 是必要的——導覽列是 sticky 的，
    不留這段空白，跳過去之後段落標題會被導覽列蓋住。
  */
  .project-back {
    max-width: var(--content-width);
    margin: 0 auto;
    /*
      上下內距對稱。原本下方是 0，返回鍵整個貼在容器底部——上面有空、下面沒有，
      按鈕看起來就不是置中的。當初設 0 是為了讓下方的 hero 緊接著，
      但那讓返回鍵自己站得很奇怪，24px 的呼吸空間值得。
    */
    padding: var(--sp-3) var(--content-gutter);
  }

  .project-anchor {
    scroll-margin-top: var(--sp-7);
  }

  .project-hero,
  .project-showcase,
  .project-body {
    max-width: var(--prose-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--sp-2);
  }

  .project-hero__summary {
    font-size: var(--font-size-body-lg);
    color: var(--color-muted);
    max-width: 65ch;
  }

  .project-body {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
