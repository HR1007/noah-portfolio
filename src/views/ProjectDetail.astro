---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import TextSection from '../components/project/TextSection.astro';
import DeviceShowcase from '../components/project/DeviceShowcase.astro';
import ExperienceDemo from '../components/project/ExperienceDemo.astro';
import FeatureSplit from '../components/project/FeatureSplit.astro';
import FeatureGrid from '../components/project/FeatureGrid.astro';
import ImageRow from '../components/project/ImageRow.astro';
import IllustrationGrid from '../components/project/IllustrationGrid.astro';
import ResearchFramework from '../components/project/ResearchFramework.astro';
import Persona from '../components/project/Persona.astro';
import DesignThemes from '../components/project/DesignThemes.astro';
import Flow from '../components/project/Flow.astro';
import ProjectQuote from '../components/project/ProjectQuote.astro';
import { getProjectImageMap } from '../lib/media';
import { assignImages } from '../lib/image-slots.mjs';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: 'en' | 'zh';
}

const { project, locale } = Astro.props;
const { hero, sections } = project.data;
const isMigrated = hero !== undefined && sections.length > 0;

const site = await getEntry('site', `main-${locale}`);
const { projectQuote } = site!.data;
const { backLabel } = site!.data.nav;

// 圖片不寫路徑/檔名在內容裡：依區塊在頁面上出現的順序，依序從該專案資料夾取圖。
// 版位規則集中在 lib/image-slots.mjs，後台顯示「第 N 格是哪個區塊」也是讀同一支，
// 兩邊不會各自算一套而失去同步。資料夾沒圖時取值為 undefined，Media 會顯示佔位框。
const images = getProjectImageMap(project.id);
const { hero: heroImage, bySection } = assignImages(project.data, images);
const imagesFor = (i: number) => bySection[i] ?? [];

const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Noah Wen`} description={project.data.summary}>
  <div class="project-back">
    <BackLink label={backLabel} href={`/${locale}/portfolio`} />
  </div>
  {
    isMigrated ? (
      <Fragment>
        <ProjectHero
          title={project.data.title}
          ctaLabel={hero!.ctaLabel}
          ctaHref={hero!.ctaHref}
          gradient={hero!.gradient}
          image={heroImage}
        />

        {sections.map((section, sectionIndex) => {
          switch (section.type) {
            case 'textSection':
              return (
                <TextSection
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  paragraphs={section.paragraphs}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'deviceShowcase':
              return <DeviceShowcase
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={section.alt}
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />;
            case 'experienceDemo':
              return (
                <ExperienceDemo
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={section.alt}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                  layout={section.layout}
                />
              );
            case 'featureSplit':
              return (
                <FeatureSplit
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  imagePosition={section.imagePosition}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={section.alt}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'featureGrid':
              return (
                <FeatureGrid
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  columns={section.columns}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'imageRow':
              return (
                <ImageRow
                  rows={section.images}
                  images={imagesFor(sectionIndex)}
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'illustrationGrid':
              return (
                <IllustrationGrid
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  alt={section.alt}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'researchFramework':
              return (
                <ResearchFramework
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  paragraphs={section.paragraphs}
                  image={imagesFor(sectionIndex)[0]}
                  ratio={section.ratio}
                  alt={section.alt}
                  layout={section.layout}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'persona':
              return (
                <Persona
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  personas={section.personas}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'designThemes':
              return (
                <DesignThemes eyebrow={section.eyebrow} heading={section.heading} themes={section.themes} images={imagesFor(sectionIndex)} ctaLabel={section.ctaLabel} ctaHref={section.ctaHref} />
              );
            case 'flow':
              return (
                <Flow
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  steps={section.steps}
                  direction={section.direction}
                  images={imagesFor(sectionIndex)}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            default:
              return null;
          }
        })}

        <ProjectQuote quote={projectQuote.quote} name={projectQuote.name} tagline={projectQuote.tagline} />
      </Fragment>
    ) : (
      <Fragment>
        <section class="project-hero">
          <h1 class="project-hero__title">{project.data.title}</h1>
          <p class="project-hero__summary">{project.data.summary}</p>
        </section>

        <section class="project-showcase">
          <Media image={images[0]} ratio="4/3" alt={`${project.data.title} showcase`} />
        </section>

        <section class="project-body">
          <Content />
        </section>
      </Fragment>
    )
  }
</BaseLayout>

<style>
  /* 返回鍵是全域導覽元件，對齊 Nav 的滿版 padding，而非各區塊寬度不一的內容欄 */
  .project-back {
    padding: var(--sp-3) var(--sp-3) 0;
  }

  .project-hero,
  .project-showcase,
  .project-body {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--sp-2);
  }

  .project-hero__summary {
    font-size: var(--font-size-body-lg);
    color: var(--color-muted);
    max-width: 65ch;
  }

  .project-body {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
