---
import { getEntry, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import BackLink from '../components/BackLink.astro';
import ProjectHero from '../components/project/ProjectHero.astro';
import TextSection from '../components/project/TextSection.astro';
import DeviceShowcase from '../components/project/DeviceShowcase.astro';
import ExperienceDemo from '../components/project/ExperienceDemo.astro';
import FeatureSplit from '../components/project/FeatureSplit.astro';
import FeatureGrid from '../components/project/FeatureGrid.astro';
import ImageRow from '../components/project/ImageRow.astro';
import IllustrationGrid from '../components/project/IllustrationGrid.astro';
import ProjectQuote from '../components/project/ProjectQuote.astro';
import { getProjectImages } from '../lib/media';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: 'en' | 'zh';
}

const { project, locale } = Astro.props;
const { hero, sections } = project.data;
const isMigrated = hero !== undefined && sections.length > 0;

const site = await getEntry('site', `main-${locale}`);
const { projectQuote } = site!.data;
const { backLabel } = site!.data.nav;

// 圖片不寫路徑/檔名在內容裡：依區塊在頁面上出現的順序，依序從該專案資料夾取下一張圖。
// 資料夾裡沒圖時 getProjectImages 回傳空陣列，取值自然是 undefined，Media 元件會自動顯示佔位框。
const images = getProjectImages(project.id);
let cursor = 0;
const nextImage = () => images[cursor++];

const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Noah Wen`} description={project.data.summary}>
  <div class="project-back">
    <BackLink label={backLabel} href={`/${locale}/portfolio`} />
  </div>
  {
    isMigrated ? (
      <Fragment>
        <ProjectHero
          title={project.data.title}
          ctaLabel={hero!.ctaLabel}
          ctaHref={hero!.ctaHref}
          image={nextImage()}
        />

        {sections.map((section) => {
          switch (section.type) {
            case 'textSection':
              return (
                <TextSection
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  paragraphs={section.paragraphs}
                />
              );
            case 'deviceShowcase':
              return <DeviceShowcase image={nextImage()} ratio={section.ratio} alt={section.alt} />;
            case 'experienceDemo':
              return (
                <ExperienceDemo
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  image={nextImage()}
                  ratio={section.ratio}
                  alt={section.alt}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'featureSplit':
              return (
                <FeatureSplit
                  heading={section.heading}
                  body={section.body}
                  imagePosition={section.imagePosition}
                  image={nextImage()}
                  ratio={section.ratio}
                  alt={section.alt}
                  ctaLabel={section.ctaLabel}
                  ctaHref={section.ctaHref}
                />
              );
            case 'featureGrid':
              return (
                <FeatureGrid
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  columns={section.columns}
                  images={section.columns.map(() => nextImage())}
                />
              );
            case 'imageRow':
              return (
                <ImageRow rows={section.images} images={section.images.map(() => nextImage())} />
              );
            case 'illustrationGrid':
              return (
                <IllustrationGrid
                  eyebrow={section.eyebrow}
                  heading={section.heading}
                  body={section.body}
                  alt={section.alt}
                  images={Array.from({ length: section.count }, () => nextImage())}
                />
              );
            default:
              return null;
          }
        })}

        <ProjectQuote quote={projectQuote.quote} name={projectQuote.name} tagline={projectQuote.tagline} />
      </Fragment>
    ) : (
      <Fragment>
        <section class="project-hero">
          <h1 class="project-hero__title">{project.data.title}</h1>
          <p class="project-hero__summary">{project.data.summary}</p>
        </section>

        <section class="project-showcase">
          <Media image={images[0]} ratio="4/3" alt={`${project.data.title} showcase`} />
        </section>

        <section class="project-body">
          <Content />
        </section>
      </Fragment>
    )
  }
</BaseLayout>

<style>
  .project-back {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-4) var(--sp-3) 0;
  }

  .project-hero,
  .project-showcase,
  .project-body {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    margin-bottom: var(--sp-2);
  }

  .project-hero__summary {
    font-size: var(--font-size-body-lg);
    color: var(--color-muted);
    max-width: 65ch;
  }

  .project-body {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
