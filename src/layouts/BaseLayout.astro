---
import '../styles/global.css';
import Marquee from '../components/Marquee.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SectionReveal from '../components/SectionReveal.astro';
import ImageViewer from '../components/ImageViewer.astro';
import { otherLocale as getOtherLocale, swapLocalePath, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const locale = (Astro.currentLocale ?? 'en') as Locale;
const otherLocale = getOtherLocale(locale);
const alternateURL = new URL(swapLocalePath(Astro.url.pathname, otherLocale), Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light' || savedTheme === 'dark') {
        document.documentElement.dataset.theme = savedTheme;
      }

      /*
        iOS Safari 只有在頁面上真的掛了 touchstart 監聽器時，才會即時套用 :active
        樣式——沒有的話，:hover/:active 這類回饋在觸控裝置上會延遲甚至整個不出現，
        因為 WebKit 要先確認「這不是要拿去捲動的手勢」才決定要不要顯示。這支監聽器
        什麼都不做，純粹讓 WebKit 願意把 :active 當一回事，全站的按下即時回饋
        （Button、PortfolioCard、ConnectChannel…）才會在手機上跟桌機一樣即時。
      */
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
    {/*
      三個一組：SVG 給支援的瀏覽器（向量、任何尺寸都銳利），ICO 給 Safari 與舊瀏覽器
      （它們不吃 SVG favicon），apple-touch-icon 給 iOS 加到主畫面時用。
      只掛 SVG 的話，Safari 會去要 /favicon.ico，拿到什麼就顯示什麼。
    */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={locale} href={canonicalURL} />
    <link rel="alternate" hreflang={otherLocale} href={alternateURL} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />}

    <SectionReveal />
  </head>
  <body>
    <Marquee />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <ImageViewer />
  </body>
</html>
