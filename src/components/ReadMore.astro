---
/*
  長段落的收合。只用在真正是大牆文字的地方（案例頁的起源段與研究方法段、
  首頁的自我介紹），不全站套用——把兩三句的段落也收起來只是多一次點擊。

  按鈕會自己判斷該不該出現：量到沒被截斷就隱藏，所以套在「現在剛好不長、
  以後可能變長」的段落上也不會多出一顆沒有作用的按鈕。

  文字完整留在 DOM 裡，只用 CSS 收合高度：SEO 與螢幕閱讀器讀到的都是全文，
  收起來的只是視覺上的高度。
*/
import { getEntry } from 'astro:content';

interface Props {
  /** 超過幾行才收合。低於這個行數的段落不會出現按鈕 */
  lines?: number;
}

/*
  預設 5 行。段落文字寬度是 65ch，中文一行約 32 字、英文約 65 字——
  5 行的門檻剛好讓長段落（osce 的 203 字中文約 6.3 行）被截到，
  短段落（star-overlay 的 88 字約 2.8 行）則不會冒出一顆沒有作用的按鈕。
*/
const { lines = 5 } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const site = await getEntry('site', `main-${locale}`);
const { more, less } = site!.data.readMore;
---

<div class="read-more" data-read-more style={`--lines: ${lines}`}>
  <div class="read-more__body" data-read-more-body>
    <slot />
  </div>
  {/* 按鈕預設藏著，量完真的有溢出才顯示 */}
  <button class="read-more__btn" data-read-more-btn type="button" hidden data-more={more} data-less={less}>
    <span data-read-more-label>{more}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-read-more]').forEach((box) => {
    const body = box.querySelector<HTMLElement>('[data-read-more-body]');
    const btn = box.querySelector<HTMLButtonElement>('[data-read-more-btn]');
    const label = box.querySelector<HTMLElement>('[data-read-more-label]');
    if (!body || !btn || !label) return;

    /*
      只有真的被截到才給按鈕。短段落也掛一顆「閱讀更多」，點下去什麼都沒發生，
      比沒有按鈕更糟。字型載入會改變行高，所以量測要等 fonts.ready。
    */
    const measure = () => {
      // 展開狀態下量不出截斷（max-height 已解除），維持現狀不要把按鈕收掉
      if (box.classList.contains('is-open')) return;
      const clipped = body.scrollHeight > body.clientHeight + 1;
      box.classList.toggle('is-clipped', clipped);
      btn.hidden = !clipped;
    };

    (document.fonts?.ready ?? Promise.resolve()).then(measure);
    window.addEventListener('resize', measure);

    btn.addEventListener('click', () => {
      const open = box.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      label.textContent = open ? btn.dataset.less! : btn.dataset.more!;
    });
  });
</script>

<style>
  /*
    不用 -webkit-line-clamp。它在 -webkit-box 裡是以「子元素」為單位計算，
    不是以「行」——段落包在 <p> 裡，clamp: 6 等於「顯示 6 個 <p>」，
    而這兩種段落各只有一兩個 <p>，等於完全沒有截到，這是先前的 bug。

    改成直接算高度：行高 × 行數。font-size 明寫在這裡，em 才有穩定的基準，
    不會因為外層某天換了字級而算錯。
  */
  .read-more__body {
    --line-height: 1.7;
    position: relative;
    font-size: var(--font-size-body);
    line-height: var(--line-height);
    max-height: calc(var(--lines) * var(--line-height) * 1em);
    overflow: hidden;
  }

  .read-more.is-open .read-more__body {
    max-height: none;
    overflow: visible;
  }

  /*
    截斷處的漸層。沒有它的話文字是被硬切一刀，看起來像壞掉而不是「還有更多」。
    只在真的被截到時出現（is-clipped 由 JS 量完才加），展開後移除。
  */
  .read-more.is-clipped:not(.is-open) .read-more__body::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: calc(var(--line-height) * 2em);
    background: linear-gradient(transparent, var(--color-bg));
    pointer-events: none;
  }

  /* 按鈕靠右下角，跟著段落的右緣走 */
  .read-more__btn {
    display: flex;
    align-items: center;
    gap: calc(var(--sp-1) / 2);
    margin-left: auto;
    margin-top: var(--sp-2);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    font-size: var(--font-size-label);
    font-family: inherit;
    cursor: pointer;
    transition: color var(--motion-fast) var(--motion-ease);
  }

  .read-more__btn:hover {
    color: var(--color-ink);
  }

  .read-more__btn svg {
    width: var(--icon-sm);
    height: var(--icon-sm);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .read-more.is-open .read-more__btn svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .read-more__btn,
    .read-more__btn svg {
      transition: none;
    }
  }
</style>
