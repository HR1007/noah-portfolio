---
interface Props {
  title: string;
  period: string;
  description: string;
}

const { title, period, description } = Astro.props;
---

<div class="experience-item">
  <div class="experience-item__heading">
    <h3 class="experience-item__title">{title}</h3>
    <span class="experience-item__period">| {period}</span>
  </div>
  <p class="experience-item__description">{description}</p>
</div>

<style>
  .experience-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .experience-item__heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .experience-item__title {
    font-size: var(--font-size-h3);
  }

  .experience-item__period {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    white-space: nowrap;
  }

  .experience-item__description {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    max-width: 65ch;
  }
</style>
