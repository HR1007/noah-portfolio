---
/*
  全螢幕圖片檢視：點案例頁上任何一張圖就打開，可以縮放與拖曳。

  為什麼值得做：這個站上的圖有大量設計系統規格表與 UI 截圖，上面印著色碼、字級、
  間距數字。原圖動輒 1500～3500px 寬，在 1120px 的內容欄裡那些數字根本讀不到。
  這不是裝飾，是把已經做好的內容變成看得見的內容。

  刻意不引入 lightbox 函式庫（硬規則：正式站台不引入 JS 函式庫）。縮放與平移
  用原生 pointer 事件就夠，也不必為了一個功能扛整包相依。
*/
import { getEntry } from 'astro:content';

const locale = Astro.currentLocale ?? 'en';
const site = await getEntry('site', `main-${locale}`);
const { close, prev, next, hint } = site!.data.viewer;
---

<div class="viewer" data-viewer hidden aria-modal="true" role="dialog">
  {/* 跟著游標走的柔光。放在底色之上、圖片之下，所以是「打在背景上的燈」 */}
  <div class="viewer__spot" data-viewer-spot aria-hidden="true"></div>

  <img class="viewer__image" data-viewer-image alt="" draggable="false" />

  <button class="viewer__btn viewer__btn--close" data-viewer-close type="button" aria-label={close}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  <button class="viewer__btn viewer__btn--prev" data-viewer-prev type="button" aria-label={prev}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
  </button>
  <button class="viewer__btn viewer__btn--next" data-viewer-next type="button" aria-label={next}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
  </button>

  <p class="viewer__hint">{hint}</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-viewer]');
  const img = document.querySelector<HTMLImageElement>('[data-viewer-image]');
  const spot = document.querySelector<HTMLElement>('[data-viewer-spot]');

  if (root && img && spot) {
    // 慣性滑行是 JS 逐幀算的，CSS 的 prefers-reduced-motion 管不到，要自己查一次
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /*
      只收內容圖，導覽列圖示與佔位框都不該點開。

      .media 涵蓋案例頁；相簿的照片牆與跑馬燈沒有經過 Media 元件，所以要另外列出來——
      先前漏了它們，相簿裡的照片點下去完全沒有反應。
    */
    const SOURCES = 'main .media img, main .photo-grid img, main .photo-marquee img';

    /*
      圖片包在連結裡時，連結優先——那張圖是「進去看這個相簿」的入口，
      不是要放大的內容。藝廊首頁的相簿封面就是這種：點下去應該進相簿，
      先前卻會跳出放大檢視，等於把入口擋掉了。
    */
    const zoomable = (el: Element | null): el is HTMLImageElement =>
      el instanceof HTMLImageElement && !el.closest('a');

    const targets = () =>
      Array.from(document.querySelectorAll<HTMLImageElement>(SOURCES)).filter(zoomable);

    let list: HTMLImageElement[] = [];
    let at = 0;
    let scale = 1;
    // x／y 是實際畫出來的位置（超出邊界時已經套過阻尼）；rawX／rawY 是手指真正
    // 移動的總量，不套阻尼——阻尼要一直從「真實位移」重新算，而不是疊加在
    // 已經被阻尼過的值上面，不然越拖阻力會越算越不準。
    let x = 0;
    let y = 0;
    let rawX = 0;
    let rawY = 0;
    let opener: HTMLElement | null = null;

    const MIN = 1;
    /*
      縮放上限每張圖各自算，不寫死。

      站上的圖解析度差很多——同樣是 1120px 的欄寬，有的原圖 1280px（只夠放大
      1.14 倍），有的 3478px（能放大 3 倍）。上限若寫死成一個大數字，低解析度
      那些圖會讓人一直放大到只剩糊掉的像素，看起來像壞掉。
      所以貼著原生解析度走，再多給一點餘裕留給「想看大一點」的可讀性需求。
    */
    let MAX = 3;

    const measure = () => {
      const shown = img.offsetWidth || 1;
      const native = img.naturalWidth || shown;
      MAX = Math.min(6, Math.max(2, (native / shown) * 1.5));
    };

    img.addEventListener('load', measure);

    const draw = () => {
      img.style.transform = `translate(${x}px, ${y}px) scale(${scale})`;
      img.style.cursor = scale > 1 ? 'grab' : 'zoom-in';
    };

    /*
      單一軸可以平移多遠，才不會讓圖片邊緣離開容器、露出空白。放大 s 倍後，
      圖比容器多出來的量的一半，就是每個方向能平移的上限——s=1 時是 0
      （完全不能拖），這跟現有「scale<=MIN 時直接不啟動拖曳」的邏輯一致。
    */
    const boundsFor = (s: number) => ({
      x: Math.max(0, (img.offsetWidth * s - img.offsetWidth) / 2),
      y: Math.max(0, (img.offsetHeight * s - img.offsetHeight) / 2),
    });

    /*
      橡皮筋阻尼：超出邊界的部分不是硬夾住，而是隨著超出量遞增阻力——拖得越
      過界，畫面跟著手指移動的比例越低。公式來自 Apple「Designing Fluid
      Interfaces」的 rubber-banding 範例，constant 越小阻力越強。
    */
    const rubberband = (overshoot: number, dimension: number, k = 0.55) =>
      (overshoot * dimension * k) / (dimension + k * Math.abs(overshoot));

    const clampAxis = (raw: number, limit: number, dimension: number) => {
      if (limit <= 0) return 0;
      if (Math.abs(raw) <= limit) return raw;
      const overshoot = Math.abs(raw) - limit;
      return Math.sign(raw) * (limit + rubberband(overshoot, dimension));
    };

    const reset = () => {
      cancelAnimationFrame(momentumId); // 上一張圖若還在慣性滑行，換圖時要先停下，不然舊的滑行會接著算到新圖上
      scale = 1;
      x = 0;
      y = 0;
      rawX = 0;
      rawY = 0;
      draw();
    };

    const load = (i: number) => {
      at = (i + list.length) % list.length;
      const source = list[at];
      img.src = source.currentSrc || source.src;
      img.alt = source.alt;
      reset();
    };

    const open = (source: HTMLImageElement) => {
      list = targets();
      const i = list.indexOf(source);
      if (i < 0) return;
      opener = source;
      load(i);
      root.hidden = false;
      // 鎖住背景捲動，否則在檢視器裡滾輪會連帶把底下的頁面捲走
      document.documentElement.style.overflow = 'hidden';
      (root.querySelector('[data-viewer-close]') as HTMLElement | null)?.focus();
    };

    const shut = () => {
      root.hidden = true;
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      // 焦點還回原本那張圖，鍵盤使用者才不會被丟回頁面最上面
      opener?.focus?.();
      opener = null;
    };

    // ---- 開啟 ----
    document.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement | null)?.closest?.(SOURCES) ?? null;
      if (zoomable(el)) open(el);
    });

    // ---- 關閉與換圖 ----
    root.querySelector('[data-viewer-close]')?.addEventListener('click', shut);
    root.querySelector('[data-viewer-prev]')?.addEventListener('click', () => load(at - 1));
    root.querySelector('[data-viewer-next]')?.addEventListener('click', () => load(at + 1));

    // 點空白處關閉，但點在圖片或按鈕上不算
    root.addEventListener('click', (e) => {
      if (e.target === root || e.target === spot) shut();
    });

    document.addEventListener('keydown', (e) => {
      if (root.hidden) return;
      if (e.key === 'Escape') shut();
      else if (e.key === 'ArrowLeft') load(at - 1);
      else if (e.key === 'ArrowRight') load(at + 1);
    });

    /*
      「校正跳接」用的 class：只在放開後回彈、或雙擊縮放這種離散的目標位置
      改變時才加上，讓那一下有個過渡而不是瞬間跳過去。拖曳與滾輪縮放全程
      不會加這個 class——那兩種是連續手勢，畫面要跟著輸入即時跑，加了
      transition 反而會拖出一截延遲，體感就不是「黏著手指」了。
    */
    let snapTimer = 0;
    const snap = () => {
      img.classList.add('viewer__image--snap');
      clearTimeout(snapTimer);
      snapTimer = window.setTimeout(() => img.classList.remove('viewer__image--snap'), 400);
    };

    // ---- 縮放：以游標為錨點，放大時游標底下的那一點不會跑掉 ----
    root.addEventListener(
      'wheel',
      (e) => {
        if (root.hidden) return;
        e.preventDefault();
        cancelAnimationFrame(momentumId); // 正在滑行時開始縮放，先中斷慣性，兩種手勢不要疊在一起
        const box = img.getBoundingClientRect();
        const cx = e.clientX - (box.left + box.width / 2);
        const cy = e.clientY - (box.top + box.height / 2);
        const next = Math.min(MAX, Math.max(MIN, scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12)));
        const k = next / scale;
        x = e.clientX - cx * k - (box.left + box.width / 2) + x;
        y = e.clientY - cy * k - (box.top + box.height / 2) + y;
        scale = next;
        if (scale === MIN) {
          x = 0;
          y = 0;
        }
        // 縮小後邊界跟著變小，目前位置可能已經超出新的邊界——重新夾一次，
        // rawX／rawY 也跟著校正，不然放大回去時會從一個過期的超出量繼續算
        const bounds = boundsFor(scale);
        x = clampAxis(x, bounds.x, img.offsetWidth);
        y = clampAxis(y, bounds.y, img.offsetHeight);
        rawX = x;
        rawY = y;
        draw();
      },
      { passive: false }
    );

    // ---- 拖曳平移：邊界有橡皮筋阻尼，放開時視情況回彈或帶慣性滑行 ----
    let dragging = false;
    let px = 0;
    let py = 0;
    // 拖曳速度（px/ms），用來源與目的地兩點的時間差算，放開時決定要不要滑行
    let vx = 0;
    let vy = 0;
    let lastMoveAt = 0;
    let momentumId = 0;

    img.addEventListener('pointerdown', (e) => {
      if (scale <= MIN) return;
      cancelAnimationFrame(momentumId); // 正在慣性滑行時被抓住：立刻停下、從當下位置繼續，不是等滑完
      dragging = true;
      px = e.clientX;
      py = e.clientY;
      vx = 0;
      vy = 0;
      lastMoveAt = performance.now();
      img.setPointerCapture(e.pointerId);
      img.style.cursor = 'grabbing';
      img.classList.remove('viewer__image--snap');
    });
    img.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastMoveAt);
      const dx = e.clientX - px;
      const dy = e.clientY - py;
      vx = dx / dt;
      vy = dy / dt;
      lastMoveAt = now;
      rawX += dx;
      rawY += dy;
      px = e.clientX;
      py = e.clientY;
      const bounds = boundsFor(scale);
      x = clampAxis(rawX, bounds.x, img.offsetWidth);
      y = clampAxis(rawY, bounds.y, img.offsetHeight);
      draw();
    });

    // 放開後若在邊界外，回彈到邊界內；在邊界內則不動，交給 glide／endDrag 判斷要不要滑行
    const settle = () => {
      const bounds = boundsFor(scale);
      const clampedX = Math.max(-bounds.x, Math.min(bounds.x, rawX));
      const clampedY = Math.max(-bounds.y, Math.min(bounds.y, rawY));
      if (clampedX !== x || clampedY !== y) snap();
      x = clampedX;
      y = clampedY;
      rawX = clampedX;
      rawY = clampedY;
      draw();
    };

    /*
      慣性滑行：放開時若還有速度，不是立刻停住，而是用摩擦力讓速度逐幀衰減，
      畫面跟著繼續滑一小段再停下——放開時的手感才不會是硬切。滑到邊界外時
      clampAxis 的阻尼會自然把它「壓」住，速度歸零或超出太多就收尾回彈。
    */
    const FRICTION = 0.93;
    const glide = () => {
      vx *= FRICTION;
      vy *= FRICTION;
      rawX += vx * 16;
      rawY += vy * 16;
      const bounds = boundsFor(scale);
      x = clampAxis(rawX, bounds.x, img.offsetWidth);
      y = clampAxis(rawY, bounds.y, img.offsetHeight);
      draw();

      const overshoot = Math.max(Math.abs(rawX) - bounds.x, Math.abs(rawY) - bounds.y);
      const settled = Math.hypot(vx, vy) < 0.02;
      if (settled || overshoot > 24) {
        settle();
        return;
      }
      momentumId = requestAnimationFrame(glide);
    };

    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      draw();
      if (!reduceMotion && Math.hypot(vx, vy) > 0.02) momentumId = requestAnimationFrame(glide);
      else settle();
    };
    img.addEventListener('pointerup', endDrag);
    img.addEventListener('pointercancel', endDrag);

    // 連點兩下在「原尺寸」與「放大兩倍」之間切換——離散的目標改變，用過渡動畫銜接
    img.addEventListener('dblclick', () => {
      cancelAnimationFrame(momentumId);
      scale = scale > MIN ? MIN : 2;
      x = 0;
      y = 0;
      rawX = 0;
      rawY = 0;
      snap();
      draw();
    });

    // ---- 聚光燈 ----
    root.addEventListener('pointermove', (e) => {
      spot.style.setProperty('--x', `${e.clientX}px`);
      spot.style.setProperty('--y', `${e.clientY}px`);
    });
  }
</script>

<style>
  /*
    這一條非寫不可：下面的 .viewer 設了 display: flex，而作者樣式的優先度高於
    瀏覽器預設樣式，所以 hidden 屬性帶來的 display: none 會被蓋掉——檢視器會
    永遠顯示，整片暗底蓋住全站。凡是對帶 hidden 的元素設 display 都要補這一條。
  */
  .viewer[hidden] {
    display: none;
  }

  .viewer {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--viewer-backdrop);
    color: var(--viewer-ink);
    overscroll-behavior: contain;
  }

  /*
    聚光燈：一圈跟著游標的柔光。--x／--y 由 JS 寫入，預設放在畫面中央，
    這樣還沒移動滑鼠前也不會整片全黑。
  */
  .viewer__spot {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle var(--viewer-spot-size) at var(--x, 50%) var(--y, 50%),
      var(--viewer-spot),
      transparent 100%
    );
    pointer-events: none;
  }

  .viewer__image {
    max-width: 92vw;
    max-height: 88vh;
    /* transform 由 JS 控制，這裡只負責原點與不被拉伸 */
    transform-origin: center;
    object-fit: contain;
    user-select: none;
    touch-action: none;
  }

  /*
    只在「校正跳接」（放開後回彈、雙擊縮放）時才加這個 class，拖曳與滾輪縮放
    全程不掛，那兩種連續手勢要跟著輸入逐幀即時更新，多了 transition 反而會
    拖出一截延遲。時長比按鈕（--motion-fast）長，是圖片這種比較大面積的
    移動本來就該比小控制項的回饋慢一點，跟 PortfolioCard 圖片 hover 用同一個倍數。
  */
  .viewer__image--snap {
    transition: transform calc(var(--motion-fast) * 3) var(--motion-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .viewer__image--snap {
      transition: none;
    }
  }

  .viewer__btn {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-size-lg);
    height: var(--control-size-lg);
    border: 1px solid var(--viewer-spot);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--viewer-ink);
    cursor: pointer;
  }

  .viewer__btn svg {
    width: var(--icon-md);
    height: var(--icon-md);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .viewer__btn:hover {
    border-color: var(--viewer-ink);
  }

  .viewer__btn--close {
    top: var(--sp-3);
    right: var(--sp-3);
  }

  .viewer__btn--prev {
    left: var(--sp-3);
  }

  .viewer__btn--next {
    right: var(--sp-3);
  }

  .viewer__hint {
    position: absolute;
    bottom: var(--sp-3);
    margin: 0;
    font-size: var(--font-size-meta);
    opacity: 0.55;
  }

  /* 觸控裝置沒有滾輪也沒有 hover，提示文字換掉沒意義的部分不如整段收起來 */
  @media (max-width: 767px) {
    .viewer__hint {
      display: none;
    }

    .viewer__btn--prev,
    .viewer__btn--next {
      bottom: var(--sp-3);
    }
  }
</style>
