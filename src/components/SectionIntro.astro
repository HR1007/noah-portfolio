---
interface Props {
  eyebrow?: string;
  headline: string;
  body?: string;
}

const { eyebrow, headline, body } = Astro.props;
---

<div class="section-intro">
  {eyebrow && <p class="section-intro__eyebrow">{eyebrow}</p>}
  <h1 class="section-intro__headline">{headline}</h1>
  {body && <p class="section-intro__body">{body}</p>}
</div>

<style>
  .section-intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-bottom: var(--sp-6);
  }

  /*
    不設 max-width，跟同一塊裡的標題與內文一樣由容器決定邊界。

    先前是 42ch，但英文的 portfolio eyebrow 有 69 個字元——在 1120px 寬的欄位裡
    明明放得下一行，卻被硬折成兩行，而且右緣跟下方的標題對不齊。
  */
  .section-intro__eyebrow {
    font-size: var(--font-size-body);
    color: var(--color-muted);
  }

  .section-intro__headline {
    font-size: var(--font-size-h1);
  }

  /*
    不設 max-width：內文右緣要與同頁下方的內容區塊（相簿卡片、照片牆）對齊在
    同一條邊界上。字數上限交由外層容器的 max-width 控制，不在這裡另外收窄。
  */
  .section-intro__body {
    font-size: var(--font-size-body);
    color: var(--color-muted);
    line-height: 1.7;
  }
</style>
