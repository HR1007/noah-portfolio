---
interface Props {
  quote: string;
}

const { quote } = Astro.props;
---

<blockquote class="pull-quote">
  <p>&ldquo;{quote}&rdquo;</p>
</blockquote>

<style>
  .pull-quote {
    text-align: center;
  }

  .pull-quote p {
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    color: var(--color-ink);
    max-width: 24ch;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .pull-quote p {
      font-size: var(--font-size-h2);
    }
  }
</style>
