---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  label?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const { image, ratio, alt, label, loading = 'lazy', fetchpriority = 'auto' } = Astro.props;
---

{
  image ? (
    <div class="media" style={`aspect-ratio: ${ratio}`}>
      <Image src={image} alt={alt} loading={loading} fetchpriority={fetchpriority} />
    </div>
  ) : (
    <Placeholder ratio={ratio} label={label ?? alt} />
  )
}

<style>
  .media {
    border-radius: var(--radius);
    overflow: hidden;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
