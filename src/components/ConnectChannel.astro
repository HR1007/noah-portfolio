---
interface Props {
  icon: 'email' | 'instagram' | 'blog';
  label: string;
  value: string;
  href: string;
}

const { icon, label, value, href } = Astro.props;
---

<a href={href} class="connect-channel">
  <span class="connect-channel__icon" aria-hidden="true">
    {/*
      三個以上就不再用巢狀三元運算——那種寫法每多一種圖示就多一層縮排，
      而且看不出「有哪些選項」。改成一個 svg 殼加上分別的內容。
    */}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      {icon === 'email' && (
        <>
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 7 8 6 8-6" />
        </>
      )}
      {icon === 'instagram' && (
        <>
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </>
      )}
      {/* 部落格：一篇有內文的文章。旁邊就有「Blog／部落格」標籤，圖示只要傳達
          「這是一篇一篇寫的東西」，不必畫成某個平台的商標 */}
      {icon === 'blog' && (
        <>
          <rect x="4" y="3" width="16" height="18" rx="2" />
          <path d="M8 8h8M8 12h8M8 16h5" />
        </>
      )}
    </svg>
  </span>
  <span class="connect-channel__text">
    <span class="connect-channel__label">{label}</span>
    <span class="connect-channel__value">{value}</span>
  </span>
</a>

<style>
  .connect-channel {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--color-ink);
  }

  .connect-channel__icon {
    flex: none;
    width: var(--control-size-lg);
    height: var(--control-size-lg);
    border-radius: calc(var(--radius) * 0.6);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
  }

  .connect-channel__icon svg {
    width: var(--icon-lg);
    height: var(--icon-lg);
  }

  .connect-channel__text {
    display: flex;
    flex-direction: column;
  }

  .connect-channel__label {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .connect-channel__value {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-medium);
  }
</style>
