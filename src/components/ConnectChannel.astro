---
interface Props {
  icon: 'email' | 'instagram';
  label: string;
  value: string;
  href: string;
}

const { icon, label, value, href } = Astro.props;
---

<a href={href} class="connect-channel">
  <span class="connect-channel__icon" aria-hidden="true">
    {
      icon === 'email' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
        </svg>
      )
    }
  </span>
  <span class="connect-channel__text">
    <span class="connect-channel__label">{label}</span>
    <span class="connect-channel__value">{value}</span>
  </span>
</a>

<style>
  .connect-channel {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--color-ink);
  }

  .connect-channel__icon {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: calc(var(--radius) * 0.6);
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
  }

  .connect-channel__icon svg {
    width: 22px;
    height: 22px;
  }

  .connect-channel__text {
    display: flex;
    flex-direction: column;
  }

  .connect-channel__label {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .connect-channel__value {
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-semibold);
  }
</style>
