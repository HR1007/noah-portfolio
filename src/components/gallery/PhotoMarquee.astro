---
/*
  相簿內頁的直向跑馬燈：照片分成幾欄持續往上流動，滑鼠停在牆面上就整片停住，
  讓人可以好好看那一張。手機上不跑，改成一條手指左右滑的照片列（見最下面的樣式）。

  為什麼不用 JS 驅動位移：那要每一幀改 transform，長長一牆照片很容易掉幀。
  純 CSS animation 交給合成執行緒跑，而且「暫停」只是 animation-play-state，
  不需要記住進度、也不會在恢復時跳一下。

  每一欄的內容重複兩次，位移到 -50% 時正好接回起點，所以看起來是無縫的。
  項目之間用 margin-bottom 而不是 gap——gap 在頭尾的數量不對稱，
  -50% 就會剛好差一個間距而出現接縫。
*/
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from '../Placeholder.astro';

interface Props {
  images: (ImageMetadata | undefined)[];
  labelPrefix: string;
  /** 沒有照片時顯示幾格佔位框 */
  placeholderCount?: number;
}

const { images, labelPrefix, placeholderCount = 9 } = Astro.props;

const items = images.length > 0
  ? images.map((image, i) => ({ image, alt: `${labelPrefix} ${String(i + 1).padStart(2, '0')}`, order: i }))
  : Array.from({ length: placeholderCount }, (_, i) => ({
      image: undefined,
      alt: `${labelPrefix} ${String(i + 1).padStart(2, '0')}`,
      order: i,
    }));

// 輪流分配到各欄，而不是切成連續幾段：同一欄裡才不會整排都是直幅或整排都是橫幅
const COLUMNS = 5;
const columns: (typeof items)[] = Array.from({ length: COLUMNS }, () => []);
items.forEach((item, i) => columns[i % COLUMNS].push(item));

---

<div class="photo-marquee" data-photo-marquee>
  {
    columns.map((column) => (
      <div class="photo-marquee__col" data-marquee-col>
        {/*
          每張照片只輸出一次。接循環所需的複本由瀏覽器端複製——需要幾份取決於
          「一個循環的高度」對上「容器高度」，而容器是 82vh，建置時量不到。
        */}
        <div class="photo-marquee__track" data-marquee-track>
          {column.map((item) => (
            <figure class="photo-marquee__item" style={`--order: ${item.order}`}>
              {item.image ? (
                <Image src={item.image} alt={item.alt} loading="lazy" />
              ) : (
                <Placeholder ratio="3/4" label={item.alt} />
              )}
            </figure>
          ))}
        </div>
      </div>
    ))
  }
</div>

<script>
  /*
    在瀏覽器裡量完再決定要複製幾份。

    無縫循環的條件是「一份內容的高度 ≥ 容器高度」，否則捲到一半會露出空白。
    建置時量不到容器高度（82vh 取決於視窗），而照片數也不一定夠——germany 只有
    16 張分到五欄，每欄 3～4 張，一份大約 500px，在 1080p 螢幕上的 740px 容器裡
    就會開天窗。

    先前是在建置時用一個猜的常數（每欄至少五張）補足，結果照片夠多的相簿也被
    補了一輪，牆上出現重複的照片。改成量了再補：不夠才補，補到剛好夠為止。
  */
  document.querySelectorAll<HTMLElement>('[data-marquee-col]').forEach((col) => {
    const track = col.querySelector<HTMLElement>('[data-marquee-track]');
    if (!track || !track.children.length) return;

    const originals = Array.from(track.children);

    // 補到一份內容超過容器高度。設上限避免量到 0 時無限迴圈（例如容器還沒排版好）
    for (let i = 0; i < 12 && track.scrollHeight < col.clientHeight; i++) {
      originals.forEach((node) => track.appendChild(node.cloneNode(true)));
    }

    // 再整份複製一次，translateY(-50%) 才會正好接回起點。
    // 複本對讀螢幕軟體是重複的雜訊，標成 aria-hidden 並清掉 alt。
    Array.from(track.children).forEach((node) => {
      const clone = node.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelector('img')?.setAttribute('alt', '');
      track.appendChild(clone);
    });

    /*
      秒數等複製完才算，而且是由「固定的每秒像素」換算，不是每欄各給一個數字。

      先前是在建置時依原始照片的長寬比總和算秒數，但要複製幾份是執行期才知道的——
      複製三份的欄位內容長三倍、秒數卻沒變，等於跑三倍快。這就是各欄速度不一致的原因。

      translateY(-50%) 移動的距離正好是「一半的軌道高度」，所以
      秒數 = 一半的高度 ÷ 每秒像素，各欄自然就同速。
    */
    const SPEED = 28; // px／秒
    track.style.setProperty('--duration', `${(track.scrollHeight / 2 / SPEED).toFixed(1)}s`);

    col.closest('[data-photo-marquee]')?.setAttribute('data-ready', '');
  });
</script>

<style>
  .photo-marquee {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-2);
    /*
      固定高度才有「流動」可言。用 vh 而不是固定 px：這面牆的意義是佔滿一個視野，
      在筆電與大螢幕上都該是差不多的比例。
    */
    height: 82vh;
    overflow: hidden;
    /* 上下淡出，照片才不是被硬切一刀。範圍收窄，只在最邊緣收一下 */
    mask-image: linear-gradient(transparent, #000 3%, #000 97%, transparent);
  }

  /*
    動畫只在複製完成後才跑（data-ready 由上面的腳本掛上）。
    沒有 JS 時就是一面靜態的照片牆——總比內容捲走之後留下一片空白好。
  */
  .photo-marquee__track {
    display: flex;
    flex-direction: column;
  }

  .photo-marquee[data-ready] .photo-marquee__track {
    animation: photo-marquee-up var(--duration) linear infinite;
    will-change: transform;
  }

  /*
    偶數欄反向：用 animation-direction: reverse 讓它從 -50% 跑回 0，也就是往下流。
    不必另外寫一組 keyframes，暫停與速度的邏輯也完全共用。
    相鄰兩欄方向相反，牆面才有交錯感，不會整片像一塊布往上拉。
  */
  .photo-marquee[data-ready] .photo-marquee__col:nth-child(even) .photo-marquee__track {
    animation-direction: reverse;
  }

  /* 滑到整片牆就停住——停的是動畫本身，不需要記進度，恢復時也不會跳一下 */
  .photo-marquee[data-ready]:hover .photo-marquee__track,
  .photo-marquee[data-ready]:focus-within .photo-marquee__track {
    animation-play-state: paused;
  }

  @keyframes photo-marquee-up {
    to {
      transform: translateY(-50%);
    }
  }

  .photo-marquee__item {
    margin: 0 0 var(--sp-2);
  }

  .photo-marquee__item :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  /* 1199 以下收成三欄：五欄在那個寬度下每張只剩一百多 px，看不到東西 */
  @media (max-width: 1199px) {
    .photo-marquee {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /*
    小螢幕與「減少動態」都不跑動畫：手機上流動的牆很難點中某一張，
    而會動的內容對前庭敏感的人是實際的障礙。這時只顯示第一份，複本要藏起來。
    桌機寬度的減少動態退回直向堆疊；手機寬度在下一段另外排成左右滑。
  */
  @media (max-width: 767px), (prefers-reduced-motion: reduce) {
    .photo-marquee {
      grid-template-columns: 1fr;
      height: auto;
      overflow: visible;
      mask-image: none;
    }

    /*
      選擇器要跟上面開動畫的那條一樣具體（含 [data-ready]）。只寫 .photo-marquee__track
      的話權重比較低、蓋不過去，手機與減少動態時照片其實一直在往上跑。
    */
    .photo-marquee[data-ready] .photo-marquee__track {
      animation: none;
    }

    .photo-marquee__item[aria-hidden='true'] {
      display: none;
    }
  }

  /*
    手機：所有照片排成一條，手指左右滑，一次停在一張的正中央。

    欄與軌道用 display: contents 拆掉，照片直接成為這一條的項目。照片在建置時是
    輪流分到各欄的，DOM 順序是 01、06、11…，用 --order 排回原本的 01、02、03。
    order 只在這裡套用：桌機的軌道裡原圖與複本共用同一個 --order，
    套了就會把同一張照片排在一起，無縫循環就斷了。

    整條往左右延伸到螢幕邊緣（抵銷內容邊距），照片滑出去時不會在內文邊界被切一刀；
    padding 與 scroll-padding 讓第一張仍然對齊標題左緣。
  */
  @media (max-width: 767px) {
    .photo-marquee {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--content-gutter));
      padding-inline: var(--content-gutter);
      scroll-padding-inline: var(--content-gutter);
    }

    .photo-marquee::-webkit-scrollbar {
      display: none;
    }

    .photo-marquee__col,
    .photo-marquee__track {
      display: contents;
    }

    /* 每張一樣寬、高度依照片比例，直幅照片會比橫幅高；左右露出一點鄰居，看得出可以滑 */
    .photo-marquee__item {
      flex: none;
      width: 85vw;
      margin: 0;
      order: var(--order);
      scroll-snap-align: center;
    }
  }
</style>
