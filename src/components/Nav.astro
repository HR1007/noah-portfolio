---
import { getEntry } from 'astro:content';
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
import NavStatus from './NavStatus.astro';

const locale = Astro.currentLocale ?? 'en';
const site = await getEntry('site', `main-${locale}`);
const { logo, links } = site!.data.nav;
const currentPath = Astro.url.pathname;
---

<nav class="nav">
  <a href={`/${locale}/`} class="nav__logo">{logo}</a>
  <div class="nav__right">
    <ul class="nav__links">
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <li>
              <a href={link.href} aria-current={isActive ? 'page' : undefined} class="nav__link">
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <NavStatus />
    <LangToggle />
    <ThemeToggle />
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .nav__logo {
    /* 100px 的字標用 light：這個尺寸下字重稍微一重就顯得笨，靠字級撐存在感就夠 */
    font-weight: var(--font-weight-light);
    font-size: var(--font-size-hero);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .nav__right {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .nav__link {
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  /*
    底線用 ::after 畫並以 scaleX 展開，而不是切換 text-decoration——
    後者只能瞬間出現或消失，沒有中間狀態可以做過場。
  */
  .nav__link {
    position: relative;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--sp-1) / -2);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--motion-ease);
  }

  .nav__link:hover::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__link::after {
      transition: none;
    }
  }

  .nav__link[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: calc(var(--sp-1) / 2);
    font-weight: var(--font-weight-medium);
  }

  @media (max-width: 1199px) {
    .nav__logo {
      font-size: var(--font-size-h1);
    }
  }

  @media (max-width: 767px) {
    .nav {
      flex-wrap: wrap;
    }

    .nav__links {
      gap: var(--sp-2);
      flex-wrap: wrap;
    }

    .nav__link {
      font-size: var(--font-size-meta);
    }
  }
</style>
