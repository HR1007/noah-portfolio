---
import type { ImageMetadata } from 'astro';
import Media from './Media.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  summary: string;
  ctaLabel: string;
  href: string;
  image: ImageMetadata | undefined;
  reverse?: boolean;
}

const { title, summary, ctaLabel, href, image, reverse = false } = Astro.props;
---

<article class:list={['portfolio-card', { 'portfolio-card--reverse': reverse }]}>
  <div class="portfolio-card__media">
    <Media image={image} ratio="16/10" alt={title} />
  </div>
  <div class="portfolio-card__body">
    <h2 class="portfolio-card__title">{title}</h2>
    <p class="portfolio-card__summary">{summary}</p>
    <Button label={ctaLabel} href={href} variant="primary" />
  </div>
</article>

<style>
  .portfolio-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: center;
    padding: var(--sp-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .portfolio-card--reverse {
    direction: rtl;
  }

  .portfolio-card--reverse > * {
    direction: ltr;
  }

  .portfolio-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
  }

  .portfolio-card__title {
    font-size: var(--font-size-h2);
  }

  .portfolio-card__summary {
    font-size: var(--font-size-body);
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .portfolio-card,
    .portfolio-card--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
