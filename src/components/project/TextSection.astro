---
import SectionCta from './SectionCta.astro';
import ReadMore from '../ReadMore.astro';
interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, paragraphs, ctaLabel, ctaHref } = Astro.props;
---

<section class="text-section">
  {eyebrow && <p class="text-section__eyebrow">{eyebrow}</p>}
  <h2 class="text-section__heading">{heading}</h2>
  {/* 這一段是案例的起源敘述，通常三百字起跳，收合後才不會一進頁面就是一面牆 */}
  <ReadMore>
    {paragraphs.map((paragraph) => <p class="text-section__body">{paragraph}</p>)}
  </ReadMore>
  <SectionCta label={ctaLabel} href={ctaHref} />
</section>

<style>
  /*
    容器已統一寬度讓左緣對齊，但整段攤在整個欄寬上，一行會太長不好讀。
    這裡只收窄「文字本身」且靠左，不用 margin auto 置中——置中會讓左緣
    又跑掉，等於白對齊。
  */

  .text-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
  }

  .text-section__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .text-section__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: justify;
  }
</style>
