---
import SectionCta from './SectionCta.astro';
interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, paragraphs, ctaLabel, ctaHref } = Astro.props;
---

<section class="text-section">
  {eyebrow && <p class="text-section__eyebrow">{eyebrow}</p>}
  <h2 class="text-section__heading">{heading}</h2>
  {paragraphs.map((paragraph) => <p class="text-section__body">{paragraph}</p>)}
  <SectionCta label={ctaLabel} href={ctaHref} />
</section>

<style>
  /*
    容器已統一寬度讓左緣對齊，但整段跑到 1040px 寬一行會太長不好讀。
    這裡只收窄「文字本身」且靠左，不用 margin auto 置中——置中會讓左緣
    又跑掉，等於白對齊。
  */
  .reading-measure {
    max-width: 65ch;
  }

  .text-section {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
  }

  .text-section__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .text-section__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }
</style>
