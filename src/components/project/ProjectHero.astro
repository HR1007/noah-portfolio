---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Button from '../Button.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata | undefined;
}

const { title, ctaLabel, ctaHref, image } = Astro.props;
// [需確認] hero 圖比例依 wireframe 目測抓 21/9，待設計師提供實際素材尺寸後調整。
---

<section class="project-hero">
  <div class="project-hero__media">
    <Media image={image} ratio="21/9" alt={`${title} hero`} loading="eager" fetchpriority="high" />
  </div>
  <div class="project-hero__overlay" class:list={{ 'project-hero__overlay--placeholder': !image }}>
    <h1 class="project-hero__title">{title}</h1>
    <Button label={ctaLabel} href={ctaHref} variant="secondary" />
  </div>
</section>

<style>
  .project-hero {
    position: relative;
  }

  .project-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    text-align: center;
    padding: var(--sp-3);
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    color: var(--color-bg);
  }

  /*
    沒有真實 hero 圖時，底下是 Placeholder 的條紋背景（跟 --color-bg 同一色系），
    白色/背景色文字會直接被吃掉、幾乎看不見，改用一般內文色。
    排版維持置中不變，圖片上傳後直接變成疊在照片上的樣子，不會有視覺跳動。
  */
  .project-hero__overlay--placeholder .project-hero__title {
    color: var(--color-ink);
  }

  /*
    Placeholder 自己在框底部顯示的檔名標籤（例如「Foodlet hero」）跟這裡的大標題
    是同一件事重複講兩次，長標題換行更容易疊在一起。這裡的大標題已經說明了
    「這是什麼」，底部標籤在 hero 這個位置沒有必要，直接隱藏，圖片上傳後
    Placeholder 整個消失，這條規則自然不會有作用。
  */
  .project-hero__media :global(.placeholder__label) {
    display: none;
  }

  @media (max-width: 767px) {
    .project-hero__title {
      font-size: var(--font-size-h2);
    }
  }
</style>
