---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import heroBackground from '../../assets/hero-background.png';
import Button from '../Button.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata | undefined;
}

const { title, ctaLabel, ctaHref, image } = Astro.props;

// hero 圖不套固定比例：直接用圖片自己的原始尺寸，只有寬度超過容器（1040px）
// 時才等比例縮小。這樣不同案例的 hero 可以是不同形狀，也永遠不會被裁切或
// 被放大超過原始解析度。沒有圖時佔位框才需要一個比例，用設計稿的 1040×675.66。
const PLACEHOLDER_RATIO = '1040 / 675.66';
---

<section class="project-hero">
  {/*
    所有案例共用同一張 hero 背景圖。alt 留空是刻意的——它純粹是裝飾，
    讀螢幕軟體不該把它唸出來，內容意義由下方的標題承擔。
  */}
  <Image class="project-hero__bg" src={heroBackground} alt="" loading="eager" fetchpriority="high" quality={90} />
  <div class="project-hero__inner">
    <h1 class="project-hero__title">{title}</h1>
    <Button label={ctaLabel} href={ctaHref} variant="secondary" />
  </div>
  {/*
    滿版圖：刻意放在 __inner 外面、自己撐開到整個視窗寬——裡面那層有
    --content-width 的上限，圖片放在裡面永遠到不了滿版。用負 margin 把
    section 自己的左右內距（--content-gutter）抵消掉，圖才會真正貼齊
    視窗左右邊，不是「比較寬的置中容器」。高度固定、object-fit: cover，
    寬螢幕或窄螢幕都會裁切——設計師已確認裁切無妨，比例不必完整保留。
  */}
  <div class="project-hero__frame">
    {
      image ? (
        <Image src={image} alt={`${title} hero`} loading="eager" fetchpriority="high" quality={90} />
      ) : (
        <Placeholder ratio={PLACEHOLDER_RATIO} label={`${title} hero`} />
      )
    }
  </div>
</section>

<style>
  /*
    版面由上到下：標題 → 按鈕 → 圖片，三者垂直排列在漸層底上，彼此不重疊。
    標題刻意不疊在圖片上——照片深淺不可控，疊上去就得靠遮罩救對比，
    而遮罩會壓暗照片本身。分開排列則兩者都能保持乾淨。
    間距統一用同一個 gap，不個別微調。
  */
  .project-hero {
    position: relative;
    overflow: hidden;
    padding: var(--sp-6) var(--content-gutter);
  }

  /*
    背景圖鋪滿整個 hero，內容疊在上面。用 <Image> 而不是 CSS background-image，
    才吃得到 astro:assets 的最佳化（webp 轉檔與尺寸產生）。
  */
  .project-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .project-hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    text-align: center;
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    /* 背景圖不隨主題反轉，文字色也不能跟著翻，否則深色模式會落在淺底上看不見 */
    color: var(--color-on-hero);
    text-wrap: balance;
    margin: 0;
  }

  /* 按鈕坐在背景圖上，邊框與文字跟標題用同一個不反轉的色 */
  .project-hero__inner :global(.button--secondary) {
    color: var(--color-on-hero);
    border-color: var(--color-on-hero);
  }

  .project-hero__frame {
    position: relative;
    z-index: 1;
    margin-top: var(--sp-4);
    /* 抵消 .project-hero 自己的左右內距，圖片才會貼齊視窗邊緣、不是置中的寬容器 */
    margin-inline: calc(-1 * var(--content-gutter));
    width: calc(100% + 2 * var(--content-gutter));
    overflow: hidden;
  }

  /*
    滿版模式：寬度鎖 100%、高度固定、object-fit: cover——裁切是刻意的，
    不像 natural 模式要完整保留原圖比例。高度沿用 --hero-max-height，
    跟這個 token 原本「hero 視覺區的高度」的意義一致，不另外發明新數字。
  */
  .project-hero__frame :global(img) {
    display: block;
    width: 100%;
    height: var(--hero-max-height);
    object-fit: cover;
  }

  /*
    Placeholder 自己在框底部顯示的檔名標籤，跟上方大標題是同一件事講兩次。
    圖片上傳後 Placeholder 消失，這條規則自然失效。
  */
  .project-hero__frame :global(.placeholder__label) {
    display: none;
  }

  @media (max-width: 767px) {
    .project-hero {
      padding: var(--sp-4) var(--sp-2);
    }

    .project-hero__title {
      font-size: var(--font-size-h2);
    }
  }
</style>
