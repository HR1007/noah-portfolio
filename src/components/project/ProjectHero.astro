---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import heroBackground from '../../assets/hero-background.png';
import Button from '../Button.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata | undefined;
}

const { title, ctaLabel, ctaHref, image } = Astro.props;

// hero 圖不套固定比例：直接用圖片自己的原始尺寸，只有寬度超過容器（1040px）
// 或高度超過 --project-hero-max-height 時才等比例縮小。這樣不同案例的 hero
// 可以是不同形狀，也永遠不會被裁切或被放大超過原始解析度。沒有圖時佔位框
// 才需要一個比例——寬度沿用設計稿的 1040，高度改用 --project-hero-max-height
// 目前的值（480），不是設計稿原始的 675.66，這樣空版位的佔位框跟上傳圖片後
// 的實際高度一致，不會上傳完圖片後方塊突然變矮一截。
// Placeholder 元件吃的是字串比例、不是 CSS var，所以這裡要手動跟 tokens.css
// 的 --project-hero-max-height 同步；改了那個 token 記得也要改這裡。
const PLACEHOLDER_RATIO = '1040 / 480';
---

<section class="project-hero">
  {/*
    所有案例共用同一張 hero 背景圖。alt 留空是刻意的——它純粹是裝飾，
    讀螢幕軟體不該把它唸出來，內容意義由下方的標題承擔。
  */}
  <Image class="project-hero__bg" src={heroBackground} alt="" loading="eager" fetchpriority="high" quality={90} />
  <div class="project-hero__inner">
    <h1 class="project-hero__title">{title}</h1>
    <Button label={ctaLabel} href={ctaHref} variant="secondary" />
    <div class="project-hero__frame">
      {
        image ? (
          <Image src={image} alt={`${title} hero`} loading="eager" fetchpriority="high" quality={90} />
        ) : (
          <Placeholder ratio={PLACEHOLDER_RATIO} label={`${title} hero`} />
        )
      }
    </div>
  </div>
</section>

<style>
  /*
    版面由上到下：標題 → 按鈕 → 圖片，三者垂直排列在漸層底上，彼此不重疊。
    標題刻意不疊在圖片上——照片深淺不可控，疊上去就得靠遮罩救對比，
    而遮罩會壓暗照片本身。分開排列則兩者都能保持乾淨。
    間距統一用同一個 gap，不個別微調。
  */
  .project-hero {
    position: relative;
    overflow: hidden;
    padding: var(--sp-6) var(--content-gutter);
  }

  /*
    背景圖鋪滿整個 hero，內容疊在上面。用 <Image> 而不是 CSS background-image，
    才吃得到 astro:assets 的最佳化（webp 轉檔與尺寸產生）。
  */
  .project-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .project-hero__inner {
    position: relative;
    z-index: 1;
    max-width: var(--content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    text-align: center;
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    /* 背景圖不隨主題反轉，文字色也不能跟著翻，否則深色模式會落在淺底上看不見 */
    color: var(--color-on-hero);
    text-wrap: balance;
    margin: 0;
  }

  /* 按鈕坐在背景圖上，邊框與文字跟標題用同一個不反轉的色 */
  .project-hero__inner :global(.button--secondary) {
    color: var(--color-on-hero);
    border-color: var(--color-on-hero);
  }

  .project-hero__frame {
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    /* 圖片比容器窄時置中，不要靠左 */
    display: flex;
    justify-content: center;
  }

  /*
    用 max-* 而非 width/height：圖片維持原始尺寸，只有超出容器寬度或高度上限
    時才縮小，不會被放大到超過原始解析度而變糊。

    width/height 同時保持 auto 是關鍵——只鎖一邊（例如只給 max-height）會讓
    另一邊維持原值，圖片就被壓扁或拉長。兩邊都 auto，瀏覽器才會等比例縮放。
  */
  .project-hero__frame :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    /* hero 專屬的高度上限，跟案例頁內文圖片共用的 --hero-max-height 分開——見 tokens.css 的註解 */
    max-height: var(--project-hero-max-height);
    display: block;
    /*
      Safari 已知的渲染問題：overflow: hidden 搭配 border-radius 的 flex
      容器，有時不會正確裁切子元素（img 被升成獨立的合成層，繞過父層的
      clip path），圓角在 Safari 看起來像完全沒套用。直接在圖片自己身上
      也補一份 border-radius，不依賴父層的 overflow 裁切，兩邊都圓，
      不管哪個瀏覽器的合成行為都一樣。inherit 直接拿父層算好的值，
      不另外寫一次 var(--radius)。
    */
    border-radius: inherit;
  }

  /*
    Placeholder 自己在框底部顯示的檔名標籤，跟上方大標題是同一件事講兩次。
    圖片上傳後 Placeholder 消失，這條規則自然失效。
  */
  .project-hero__frame :global(.placeholder__label) {
    display: none;
  }

  @media (max-width: 767px) {
    .project-hero {
      padding: var(--sp-4) var(--sp-2);
    }

    .project-hero__title {
      font-size: var(--font-size-h2);
    }
  }
</style>
