---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Placeholder from '../Placeholder.astro';
import Button from '../Button.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata | undefined;
  gradient?: 'warm' | 'cool' | 'violet' | 'mint' | 'slate';
}

const { title, ctaLabel, ctaHref, image, gradient = 'slate' } = Astro.props;

// hero 圖不套固定比例：直接用圖片自己的原始尺寸，只有寬度超過容器（1040px）
// 時才等比例縮小。這樣不同案例的 hero 可以是不同形狀，也永遠不會被裁切或
// 被放大超過原始解析度。沒有圖時佔位框才需要一個比例，用設計稿的 1040×675.66。
const PLACEHOLDER_RATIO = '1040 / 675.66';
---

<section class="project-hero" data-gradient={gradient}>
  <div class="project-hero__inner">
    <h1 class="project-hero__title">{title}</h1>
    <Button label={ctaLabel} href={ctaHref} variant="secondary" />
    <div class="project-hero__frame">
      {
        image ? (
          <Image src={image} alt={`${title} hero`} loading="eager" fetchpriority="high" />
        ) : (
          <Placeholder ratio={PLACEHOLDER_RATIO} label={`${title} hero`} />
        )
      }
    </div>
  </div>
</section>

<style>
  /*
    版面由上到下：標題 → 按鈕 → 圖片，三者垂直排列在漸層底上，彼此不重疊。
    標題刻意不疊在圖片上——照片深淺不可控，疊上去就得靠遮罩救對比，
    而遮罩會壓暗照片本身。分開排列則兩者都能保持乾淨。
    間距統一用同一個 gap，不個別微調。
  */
  .project-hero {
    padding: var(--sp-6) var(--sp-3);
  }

  .project-hero[data-gradient='warm'] { background: var(--gradient-warm); }
  .project-hero[data-gradient='cool'] { background: var(--gradient-cool); }
  .project-hero[data-gradient='violet'] { background: var(--gradient-violet); }
  .project-hero[data-gradient='mint'] { background: var(--gradient-mint); }
  .project-hero[data-gradient='slate'] { background: var(--gradient-slate); }

  .project-hero {
    /* hero 圖的高度上限；改這一個值就能調整所有案例的 hero 高度 */
    --hero-max-height: 675.66px;
  }

  .project-hero__inner {
    max-width: var(--project-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    text-align: center;
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    /* 漸層不隨主題反轉，文字色也不能跟著翻，否則深色模式會落在淺底上看不見 */
    color: var(--color-on-gradient);
    text-wrap: balance;
    margin: 0;
  }

  /* 按鈕坐在漸層上，邊框與文字都改用同一個不反轉的色 */
  .project-hero__inner :global(.button--secondary) {
    color: var(--color-on-gradient);
    border-color: var(--color-on-gradient);
  }

  .project-hero__frame {
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    /* 圖片比容器窄時置中，不要靠左 */
    display: flex;
    justify-content: center;
  }

  /*
    用 max-* 而非 width/height：圖片維持原始尺寸，只有超出容器寬度或高度上限
    時才縮小，不會被放大到超過原始解析度而變糊。

    width/height 同時保持 auto 是關鍵——只鎖一邊（例如只給 max-height）會讓
    另一邊維持原值，圖片就被壓扁或拉長。兩邊都 auto，瀏覽器才會等比例縮放。
  */
  .project-hero__frame :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: var(--hero-max-height);
    display: block;
  }

  /*
    Placeholder 自己在框底部顯示的檔名標籤，跟上方大標題是同一件事講兩次。
    圖片上傳後 Placeholder 消失，這條規則自然失效。
  */
  .project-hero__frame :global(.placeholder__label) {
    display: none;
  }

  @media (max-width: 767px) {
    .project-hero {
      padding: var(--sp-4) var(--sp-2);
    }

    .project-hero__title {
      font-size: var(--font-size-h2);
    }
  }
</style>
