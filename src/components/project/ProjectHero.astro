---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Button from '../Button.astro';

interface Props {
  title: string;
  ctaLabel: string;
  ctaHref: string;
  image: ImageMetadata | undefined;
  gradient?: 'warm' | 'cool' | 'violet' | 'mint' | 'slate';
}

const { title, ctaLabel, ctaHref, image, gradient = 'slate' } = Astro.props;
// [需確認] hero 圖比例依 wireframe 目測抓 21/9，待設計師提供實際素材尺寸後調整。
---

<section class="project-hero" data-gradient={gradient}>
  <div class="project-hero__inner">
    <h1 class="project-hero__title">{title}</h1>
    <Button label={ctaLabel} href={ctaHref} variant="secondary" />
    <div class="project-hero__frame">
      <Media image={image} ratio="21/9" alt={`${title} hero`} loading="eager" fetchpriority="high" />
    </div>
  </div>
</section>

<style>
  /*
    版面由上到下：標題 → 按鈕 → 圖片，三者垂直排列在漸層底上，彼此不重疊。
    標題刻意不疊在圖片上——照片深淺不可控，疊上去就得靠遮罩救對比，
    而遮罩會壓暗照片本身。分開排列則兩者都能保持乾淨。
    間距統一用同一個 gap，不個別微調。
  */
  .project-hero {
    padding: var(--sp-6) var(--sp-3);
  }

  .project-hero[data-gradient='warm'] { background: var(--gradient-warm); }
  .project-hero[data-gradient='cool'] { background: var(--gradient-cool); }
  .project-hero[data-gradient='violet'] { background: var(--gradient-violet); }
  .project-hero[data-gradient='mint'] { background: var(--gradient-mint); }
  .project-hero[data-gradient='slate'] { background: var(--gradient-slate); }

  .project-hero__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
    text-align: center;
  }

  .project-hero__title {
    font-size: var(--font-size-h1);
    /* 漸層不隨主題反轉，文字色也不能跟著翻，否則深色模式會落在淺底上看不見 */
    color: var(--color-on-gradient);
    text-wrap: balance;
    margin: 0;
  }

  /* 按鈕坐在漸層上，邊框與文字都改用同一個不反轉的色 */
  .project-hero__inner :global(.button--secondary) {
    color: var(--color-on-gradient);
    border-color: var(--color-on-gradient);
  }

  .project-hero__frame {
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }

  /*
    Placeholder 自己在框底部顯示的檔名標籤，跟上方大標題是同一件事講兩次。
    圖片上傳後 Placeholder 消失，這條規則自然失效。
  */
  .project-hero__frame :global(.placeholder__label) {
    display: none;
  }

  @media (max-width: 767px) {
    .project-hero {
      padding: var(--sp-4) var(--sp-2);
    }

    .project-hero__title {
      font-size: var(--font-size-h2);
    }
  }
</style>
