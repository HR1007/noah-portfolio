---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Step {
  label: string;
  ratio: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  steps: Step[];
  images: (ImageMetadata | undefined)[];
  direction?: 'horizontal' | 'vertical';  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, body, steps, images, direction = 'horizontal', ctaLabel, ctaHref } = Astro.props;
---

<section class="flow" data-direction={direction}>
  <div class="flow__intro">
    {eyebrow && <p class="flow__eyebrow">{eyebrow}</p>}
    <h2 class="flow__heading">{heading}</h2>
    {body && <p class="flow__body">{body}</p>}
  </div>
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="flow__steps" style={`--columns: ${steps.length}`}>
    {
      steps.map((step, index) => (
        <div class="flow__step">
          {/* 只放圖：步驟編號與名稱不在頁面上呈現，圖本身已經說明了這一步。
              label 仍保留在資料裡，供後台的版位標籤辨識「這格是哪一步」。 */}
          <Media fit="natural" image={images[index]} ratio={step.ratio} alt={step.alt} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .flow {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .flow__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--project-width);
  }

  .flow__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .flow__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }

  /*
    horizontal：步驟並排成一列，欄數等於步驟數。
    vertical：一步一列往下排，適合步驟多或每步的圖較寬的情況。
  */
  .flow__steps {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--sp-3);
  }

  .flow[data-direction='vertical'] .flow__steps {
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  .flow__step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  @media (max-width: 767px) {
    .flow__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
