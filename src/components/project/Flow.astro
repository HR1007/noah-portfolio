---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Step {
  label: string;
  ratio: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  steps: Step[];
  images: (ImageMetadata | undefined)[];
}

const { eyebrow, heading, body, steps, images } = Astro.props;
---

<section class="flow">
  <div class="flow__intro">
    {eyebrow && <p class="flow__eyebrow">{eyebrow}</p>}
    <h2 class="flow__heading">{heading}</h2>
    {body && <p class="flow__body">{body}</p>}
  </div>
  <div class="flow__steps" style={`--columns: ${steps.length}`}>
    {
      steps.map((step, index) => (
        <div class="flow__step">
          <Media image={images[index]} ratio={step.ratio} alt={step.alt} />
          <p class="flow__step-label">
            <span class="flow__step-index">{index + 1}</span>
            {step.label}
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .flow {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .flow__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 800px;
  }

  .flow__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .flow__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }

  .flow__steps {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--sp-3);
  }

  .flow__step {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .flow__step-label {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    font-size: var(--font-size-label);
    color: var(--color-muted);
  }

  .flow__step-index {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: var(--font-size-meta);
    font-weight: var(--font-weight-semibold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 767px) {
    .flow__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
