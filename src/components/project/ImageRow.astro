---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Row {
  ratio: string;
  alt: string;
}

interface Props {
  rows: Row[];
  images: (ImageMetadata | undefined)[];
  eyebrow?: string;
  heading?: string;
  direction?: 'horizontal' | 'vertical';  ctaLabel?: string;
  ctaHref?: string;
}

const { rows, images, eyebrow, heading, direction = 'horizontal', ctaLabel, ctaHref } = Astro.props;
---

<section class="image-row-section" data-direction={direction}>
  {
    (eyebrow || heading) && (
      <div class="section-intro-block">
        {eyebrow && <p class="section-intro-block__eyebrow">{eyebrow}</p>}
        {heading && <h2 class="section-intro-block__heading">{heading}</h2>}
      </div>
    )
  }
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="image-row" style={`--columns: ${rows.length}`}>
    {rows.map((row, index) => <Media fit="natural" image={images[index]} ratio={row.ratio} alt={row.alt} />)}
  </div>
</section>

<style>
  .image-row-section {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--content-gutter) var(--sp-6);
  }

  /* 區塊小標與標題：與其他段落型別共用同一組樣式，新增作品頁時外觀才會一致 */
  .section-intro-block {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .section-intro-block__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-intro-block__heading {
    font-size: var(--font-size-h2);
  }

  /*
    align-items: end——這一排的圖片長寬比不一定相同（例如手機 3:4 直幅對平板/桌機
    16:9 橫幅），natural 模式不裁切，各自依原始比例算高度，高度自然差很多。
    不對齊的話矮的那幾張會浮在頂端、跟高的那張留出一截不對稱的空白，讀起來
    像沒排好；統一貼齊底部，就像裝置一起放在同一條地平線上，是這類混合尺寸
    裝置圖常見的處理方式。
  */
  .image-row {
    padding: 0 var(--content-gutter) var(--sp-6);
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    align-items: end;
    gap: var(--sp-3);
  }

  /* vertical：一張一列，圖片放大到整個內容欄寬 */
  .image-row-section[data-direction='vertical'] .image-row {
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  @media (max-width: 767px) {
    .image-row {
      grid-template-columns: 1fr;
    }
  }
</style>
