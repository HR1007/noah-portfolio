---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Row {
  ratio: string;
  alt: string;
}

interface Props {
  rows: Row[];
  images: (ImageMetadata | undefined)[];
  eyebrow?: string;
  heading?: string;  ctaLabel?: string;
  ctaHref?: string;
}

const { rows, images, eyebrow, heading, ctaLabel, ctaHref } = Astro.props;
---

<section class="image-row-section">
  {
    (eyebrow || heading) && (
      <div class="section-intro-block">
        {eyebrow && <p class="section-intro-block__eyebrow">{eyebrow}</p>}
        {heading && <h2 class="section-intro-block__heading">{heading}</h2>}
      </div>
    )
  }
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="image-row" style={`--columns: ${rows.length}`}>
    {rows.map((row, index) => <Media fit="natural" image={images[index]} ratio={row.ratio} alt={row.alt} />)}
  </div>
</section>

<style>
  .image-row-section {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: 0 var(--sp-3) var(--sp-6);
  }

  /* 區塊小標與標題：與其他段落型別共用同一組樣式，新增作品頁時外觀才會一致 */
  .section-intro-block {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .section-intro-block__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-intro-block__heading {
    font-size: var(--font-size-h2);
  }

  .image-row {
    padding: 0 var(--sp-3) var(--sp-6);
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--sp-3);
  }

  @media (max-width: 767px) {
    .image-row {
      grid-template-columns: 1fr;
    }
  }
</style>
