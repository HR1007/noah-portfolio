---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Button from '../Button.astro';

interface Props {
  heading: string;
  body: string;
  imagePosition: 'left' | 'right';
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  ctaLabel?: string;
  ctaHref?: string;
  eyebrow?: string;
}

const { heading, body, imagePosition, image, ratio, alt, ctaLabel, ctaHref, eyebrow } = Astro.props;
---

<section class:list={['feature-split', `feature-split--${imagePosition}`]}>
  <div class="feature-split__media">
    <Media fit="natural" image={image} ratio={ratio} alt={alt} />
  </div>
  <div class="feature-split__body">
    {eyebrow && <p class="feature-split__eyebrow">{eyebrow}</p>}
      <h2 class="feature-split__heading">{heading}</h2>
    <p class="feature-split__text">{body}</p>
    {ctaLabel && ctaHref && <Button label={ctaLabel} href={ctaHref} variant="primary" />}
  </div>
</section>

<style>
  .feature-split__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-1);
  }

  .feature-split {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: center;
  }

  .feature-split--right {
    direction: rtl;
  }

  .feature-split--right > * {
    direction: ltr;
  }

  .feature-split__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
  }

  .feature-split__text {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }

  @media (max-width: 767px) {
    .feature-split,
    .feature-split--right {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
