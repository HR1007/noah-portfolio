---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import DemoVideo from './DemoVideo.astro';
import ChatReplay, { type ChatData } from './ChatReplay.astro';
import Button from '../Button.astro';

interface Props {
  heading: string;
  body: string;
  imagePosition: 'left' | 'right';
  image: ImageMetadata | undefined;
  /** 版位影片，選填。有的話取代圖片；見 lib/media.ts 的 getProjectVideoMap */
  video?: string | undefined;
  ratio: string;
  alt: string;
  ctaLabel?: string;
  ctaHref?: string;
  eyebrow?: string;
  /** 對話重播，選填。有的話圖片那一側換成一支手機，段落的圖變成對話裡傳出去的截圖 */
  chat?: ChatData;
}

const { heading, body, imagePosition, image, video, ratio, alt, ctaLabel, ctaHref, eyebrow, chat } = Astro.props;
---

<section class:list={['feature-split', `feature-split--${imagePosition}`]}>
  <div class="feature-split__media">
    {
      chat ? (
        <ChatReplay chat={chat} shot={image} shotAlt={alt} shotRatio={ratio} />
      ) : video ? (
        <DemoVideo src={video} ratio={ratio} alt={alt} />
      ) : (
        <Media fit="natural" image={image} ratio={ratio} alt={alt} />
      )
    }
  </div>
  <div class="feature-split__body">
    {eyebrow && <p class="feature-split__eyebrow">{eyebrow}</p>}
      <h2 class="feature-split__heading">{heading}</h2>
    <p class="feature-split__text">{body}</p>
    {ctaLabel && ctaHref && <Button label={ctaLabel} href={ctaHref} variant="primary" />}
  </div>
</section>

<style>
  .feature-split__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--sp-1);
  }

  .feature-split {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: center;
  }

  .feature-split--right {
    direction: rtl;
  }

  .feature-split--right > * {
    direction: ltr;
  }

  .feature-split__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
  }

  .feature-split__text {
    max-width: var(--prose-width);
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .feature-split,
    .feature-split--right {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
