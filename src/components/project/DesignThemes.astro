---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Theme {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  themes: Theme[];
  images?: (ImageMetadata | undefined)[];
}

const { eyebrow, heading, themes, images = [] } = Astro.props;
---

<section class="design-themes">
  <div class="design-themes__intro">
    {eyebrow && <p class="design-themes__eyebrow">{eyebrow}</p>}
    <h2 class="design-themes__heading">{heading}</h2>
  </div>
  <div class="design-themes__grid">
    {
      themes.map((theme, i) => (
        <div class="design-themes__card">
          {/* 只放圖：標題與說明文字都不在頁面上呈現，連還沒上傳時的佔位框也不標字
              （這些圖本身就帶著自己的標題）。title 仍保留在資料裡，供 alt 與後台版位標籤使用。 */}
          <div class="design-themes__media">
            <Media image={images[i]} ratio="4/3" alt={theme.title} fit="natural" label="" />
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .design-themes {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .design-themes__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .design-themes__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /*
    卡片格線改為單欄直向堆疊：這個區塊的內容只有圖片（設計系統的截圖、
    色票、字體規格），擠成多欄後每張都太小看不清細節。改成一張一列、
    佔滿容器寬度，圖片仍由 Media 的 natural 模式維持原始比例不裁切。
  */
  .design-themes__grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .design-themes__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

</style>
