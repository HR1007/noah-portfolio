---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Theme {
  title: string;
  // schema 是 z.string().optional()，這裡跟著選填。
  // 元件也已經處理沒填的情況：沒有 description 就只出標題。
  description?: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  themes: Theme[];
  images?: (ImageMetadata | undefined)[];
  direction?: 'vertical' | 'horizontal';
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, themes, images = [], direction = 'vertical', ctaLabel, ctaHref } = Astro.props;
---

<section class="design-themes" data-direction={direction}>
  <div class="design-themes__intro">
    {eyebrow && <p class="design-themes__eyebrow">{eyebrow}</p>}
    <h2 class="design-themes__heading">{heading}</h2>
  </div>
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="design-themes__grid" style={`--columns: ${themes.length}`}>
    {
      themes.map((theme, i) => (
        <article class="design-themes__item">
          {/*
            maxHeight 給 none，刻意不設高度上限。natural 模式下 max-height 一旦撞到，
            寬度會跟著等比縮小——而這一區的圖長寬比各不相同（有橫有直），全部先撞到
            同一個高度上限後就各縮各的寬度，同一段落裡的圖左右邊緣對不齊。
            只讓容器寬度當唯一的約束，才會齊寬。
          */}
          <Media image={images[i]} ratio="4/3" alt={theme.title} fit="natural" label="" maxHeight="none" />
          {/*
            圖說用的就是後台既有的「主題標題」與「主題說明」兩個欄位，沒有另外開新欄位——
            那兩欄本來就存在、後台也一直編得到，先前只是沒有渲染出來而已。
            description 是選填，沒填就只出標題，不留一塊空白。
          */}
          <div class="design-themes__caption">
            <h3 class="design-themes__title">{theme.title}</h3>
            {theme.description && <p class="design-themes__text">{theme.description}</p>}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .design-themes {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .design-themes__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .design-themes__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /*
    vertical（預設）：一張一列、佔滿容器寬度。這一區放的是設計系統的截圖、色票、
    字體規格，擠成多欄後每張都太小看不清細節，所以預設直排。
    horizontal：並排成一列，欄數等於主題數，適合圖本身就窄的情況。

    圖片外面不包卡片。那層卡片是當初要放主題標題與說明文字才加的，文字拿掉後
    只剩一個空框——而且框自己有 --radius 圓角、裡面的圖也有 --radius 圓角，
    兩層同樣的圓角隔著內距疊在一起，看起來就是兩種圓角。現在整區只剩圖片
    本身這一層。圖片則由 Media 的 natural 模式維持原始比例不裁切。
  */
  .design-themes__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: var(--sp-5);
  }

  /* 圖與圖說是一組，直向排列後整組當成格線裡的一格 */
  .design-themes__item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .design-themes__caption {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    /* 圖說不跟著圖片一樣寬：一行文字太長會讀不完整行就跳行 */
    max-width: 68ch;
  }

  .design-themes__title {
    font-size: var(--font-size-h3);
  }

  .design-themes__text {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }

  .design-themes[data-direction='vertical'] .design-themes__grid {
    grid-template-columns: 1fr;
  }

  /* 小螢幕一律單欄：橫排在 375 上每欄只剩幾十 px，等於看不到內容 */
  @media (max-width: 767px) {
    .design-themes__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
