---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Theme {
  title: string;
  description: string;
}

interface Props {
  eyebrow?: string;
  heading: string;
  themes: Theme[];
  images?: (ImageMetadata | undefined)[];
}

const { eyebrow, heading, themes, images = [] } = Astro.props;
---

<section class="design-themes">
  <div class="design-themes__intro">
    {eyebrow && <p class="design-themes__eyebrow">{eyebrow}</p>}
    <h2 class="design-themes__heading">{heading}</h2>
  </div>
  <div class="design-themes__grid">
    {
      themes.map((theme, i) => (
        <div class="design-themes__card">
          {/* 只放圖：標題與說明文字不在頁面上呈現，title 仍保留在資料裡
              供 alt 文字與後台的版位標籤使用 */}
          <div class="design-themes__media">
            <Media
              image={images[i]}
              ratio="4/3"
              alt={theme.title}
              fit="natural"
              label={theme.title}
            />
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .design-themes {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .design-themes__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .design-themes__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .design-themes__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--sp-4);
  }

  .design-themes__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

</style>
