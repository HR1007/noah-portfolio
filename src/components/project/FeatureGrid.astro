---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Column {
  heading: string;
  body: string;
  ratio: string;
  alt: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  columns: Column[];
  images: (ImageMetadata | undefined)[];
}

const { eyebrow, heading, columns, images } = Astro.props;
---

<section class="feature-grid">
  {
    (eyebrow || heading) && (
      <div class="feature-grid__intro">
        {eyebrow && <p class="feature-grid__eyebrow">{eyebrow}</p>}
        {heading && <h2 class="feature-grid__heading">{heading}</h2>}
      </div>
    )
  }
  <div class="feature-grid__columns">
    {
      columns.map((column, index) => (
        <div class="feature-grid__column">
          <Media image={images[index]} ratio={column.ratio} alt={column.alt} />
          <h3 class="feature-grid__column-heading">{column.heading}</h3>
          <p class="feature-grid__column-body">{column.body}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .feature-grid {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .feature-grid__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .feature-grid__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .feature-grid__columns {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .feature-grid__column {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .feature-grid__column-body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .feature-grid__columns {
      grid-template-columns: 1fr;
    }
  }
</style>
