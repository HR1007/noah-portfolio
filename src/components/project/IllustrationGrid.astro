---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body?: string;
  alt: string;
  images: (ImageMetadata | undefined)[];  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, body, alt, images, ctaLabel, ctaHref } = Astro.props;
---

<section class="illustration-grid">
  <div class="illustration-grid__intro">
    {eyebrow && <p class="illustration-grid__eyebrow">{eyebrow}</p>}
    <h2 class="illustration-grid__heading">{heading}</h2>
    {body && <p class="illustration-grid__body">{body}</p>}
  </div>
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="illustration-grid__tiles">
    {images.map((image, index) => (
      <Media fit="natural" image={image} ratio="1/1" alt={`${alt} ${index + 1}`} />
    ))}
  </div>
</section>

<style>
  .illustration-grid {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .illustration-grid__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--project-width);
  }

  .illustration-grid__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .illustration-grid__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }

  .illustration-grid__tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-2);
  }

  @media (max-width: 767px) {
    .illustration-grid__tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
