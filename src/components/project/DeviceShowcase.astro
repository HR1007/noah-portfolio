---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Props {
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
}

const { image, ratio, alt } = Astro.props;
---

<section class="device-showcase">
  <Media image={image} ratio={ratio} alt={alt} />
</section>

<style>
  .device-showcase {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--sp-3) var(--sp-6);
  }
</style>
