---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';

interface Props {
  image: ImageMetadata | undefined;
  /** 深色模式變體，選填。沒有時一律顯示淺色版本，見 lib/media.ts 的 getDeviceShowcaseDarkImage */
  imageDark?: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  eyebrow?: string;
  heading?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { image, imageDark, ratio, alt, eyebrow, heading, ctaLabel, ctaHref } = Astro.props;
---

<section class="device-showcase">
  {
    (eyebrow || heading) && (
      <div class="section-intro-block">
        {eyebrow && <p class="section-intro-block__eyebrow">{eyebrow}</p>}
        {heading && <h2 class="section-intro-block__heading">{heading}</h2>}
      </div>
    )
  }
  <SectionCta label={ctaLabel} href={ctaHref} />
  {/*
    有深色版本時兩張圖疊在一起：淺色版正常排版撐出容器大小，深色版絕對定位
    蓋在上面，用網站既有的 :root[data-theme] 機制（跟 ThemeToggle／tokens.css
    同一套，不是另外發明的）切換透明度顯示哪一張——純 CSS，不需要 JS。
    沒有深色版本時就是原本的單張圖，完全不受影響。
  */}
  <div class="device-showcase__media">
    <Media fit="natural" image={image} ratio={ratio} alt={alt} />
    {imageDark && (
      <div class="device-showcase__media-dark">
        <Media fit="natural" image={imageDark} ratio={ratio} alt={`${alt}（深色模式）`} />
      </div>
    )}
  </div>
</section>

<style>
  /* 區塊小標與標題：與其他段落型別共用同一組樣式，新增作品頁時外觀才會一致 */
  .section-intro-block {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin-bottom: var(--sp-3);
  }

  .section-intro-block__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-intro-block__heading {
    font-size: var(--font-size-h2);
  }

  .device-showcase {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 var(--content-gutter) var(--sp-6);
  }

  .device-showcase__media {
    position: relative;
  }

  /*
    深色版絕對定位蓋滿淺色版撐出來的框——兩張圖假設尺寸一致（同一張截圖的
    深色變體），所以直接 inset:0 貼滿即可，不需要另外量尺寸。
  */
  .device-showcase__media-dark {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--motion-fast) var(--motion-ease);
  }

  .device-showcase__media-dark :global(.media) {
    width: 100%;
    height: 100%;
  }

  :root[data-theme='dark'] .device-showcase__media-dark {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .device-showcase__media-dark {
      transition: none;
    }
  }
</style>
