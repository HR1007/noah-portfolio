---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Button from '../Button.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  ctaLabel?: string;
  ctaHref?: string;
  layout?: 'stacked' | 'split';
}

const { eyebrow, heading, body, image, ratio, alt, ctaLabel, ctaHref, layout = 'stacked' } = Astro.props;
---

<section class="experience-demo" data-layout={layout}>
  <div class="experience-demo__intro">
    {eyebrow && <p class="experience-demo__eyebrow">{eyebrow}</p>}
    <h2 class="experience-demo__heading">{heading}</h2>
    <p class="experience-demo__body">{body}</p>
    {ctaLabel && ctaHref && <Button label={ctaLabel} href={ctaHref} variant="primary" />}
  </div>
  <div class="experience-demo__media">
    <Media fit="natural" image={image} ratio={ratio} alt={alt} />
  </div>
</section>

<style>
  .experience-demo {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  /*
    split：文字在左、圖片在右。用 grid 而非 flex-direction: row，
    兩欄才能各自等分且在 768 以下乾淨地落回單欄。
  */
  .experience-demo[data-layout='split'] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--sp-5);
  }

  @media (max-width: 767px) {
    .experience-demo[data-layout='split'] {
      grid-template-columns: 1fr;
    }
  }

  .experience-demo__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    max-width: var(--project-width);
  }

  .experience-demo__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .experience-demo__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }
</style>
