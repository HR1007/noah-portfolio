---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
}

const { eyebrow, heading, body, image, ratio, alt } = Astro.props;
---

<section class="experience-demo">
  <div class="experience-demo__intro">
    {eyebrow && <p class="experience-demo__eyebrow">{eyebrow}</p>}
    <h2 class="experience-demo__heading">{heading}</h2>
    <p class="experience-demo__body">{body}</p>
  </div>
  <div class="experience-demo__media">
    <Media image={image} ratio={ratio} alt={alt} />
  </div>
</section>

<style>
  .experience-demo {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .experience-demo__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 800px;
  }

  .experience-demo__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .experience-demo__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
  }
</style>
