---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
}

const { eyebrow, heading, paragraphs, image, ratio, alt } = Astro.props;
---

<section class="research-framework">
  <div class="research-framework__intro">
    {eyebrow && <p class="research-framework__eyebrow">{eyebrow}</p>}
    <h2 class="research-framework__heading">{heading}</h2>
    {paragraphs.map((paragraph) => <p class="research-framework__body">{paragraph}</p>)}
  </div>
  <div class="research-framework__media">
    <Media image={image} ratio={ratio} alt={alt} />
  </div>
</section>

<style>
  .research-framework {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .research-framework__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 800px;
  }

  .research-framework__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .research-framework__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }
</style>
