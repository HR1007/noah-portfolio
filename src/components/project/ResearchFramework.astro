---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import SectionCta from './SectionCta.astro';
import ReadMore from './ReadMore.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  layout?: 'stacked' | 'split' | 'split-reverse';
  ctaLabel?: string;
  ctaHref?: string;
}

const { eyebrow, heading, paragraphs, image, ratio, alt, layout = 'stacked', ctaLabel, ctaHref } = Astro.props;
---

<section class="research-framework" data-layout={layout}>
  <div class="research-framework__intro">
    {eyebrow && <p class="research-framework__eyebrow">{eyebrow}</p>}
    <h2 class="research-framework__heading">{heading}</h2>
    {/* 研究方法的段落同樣是大牆文字，收合處理 */}
    <ReadMore>
      {paragraphs.map((paragraph) => <p class="research-framework__body">{paragraph}</p>)}
    </ReadMore>
  </div>
  <SectionCta label={ctaLabel} href={ctaHref} />
  <div class="research-framework__media">
    <Media fit="natural" image={image} ratio={ratio} alt={alt} />
  </div>
</section>

<style>
  /*
    容器已統一寬度讓左緣對齊，但整段攤在整個欄寬上，一行會太長不好讀。
    這裡只收窄「文字本身」且靠左，不用 margin auto 置中——置中會讓左緣
    又跑掉，等於白對齊。
  */

  /* split：文字在左、圖片在右；768 以下落回單欄 */
  /*
    split：左文右圖；split-reverse：左圖右文。
    兩者共用同一套 grid，只用 order 交換視覺順序——不動 DOM 順序，
    螢幕閱讀器與鍵盤仍照「先標題文字、後圖片」的邏輯讀，不會因為
    視覺翻面就把閱讀順序也翻掉。
  */
  .research-framework[data-layout='split'],
  .research-framework[data-layout='split-reverse'] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--sp-5);
  }

  .research-framework[data-layout='split-reverse'] .research-framework__intro {
    order: 2;
  }

  .research-framework[data-layout='split-reverse'] .research-framework__media {
    order: 1;
  }

  @media (max-width: 767px) {
    .research-framework[data-layout='split'],
    .research-framework[data-layout='split-reverse'] {
      grid-template-columns: 1fr;
    }

    .research-framework[data-layout='split-reverse'] .research-framework__intro,
    .research-framework[data-layout='split-reverse'] .research-framework__media {
      order: initial;
    }
  }

  .research-framework {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--content-gutter);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .research-framework__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--content-width);
  }

  .research-framework__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .research-framework__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: justify;
    /*
      收窄文字本身、靠左，不用 margin auto——置中會讓左緣又跑掉，等於白對齊。
      這一行是上面那段註解一直在描述、但實際上從來沒有寫進去的東西：
      段落原本攤在整個 1120px 欄寬上，中文一行五十幾個字，讀起來要一直找行首。
    */
    max-width: var(--text-measure);
  }
</style>
