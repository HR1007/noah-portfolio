---
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraphs: string[];
  image: ImageMetadata | undefined;
  ratio: string;
  alt: string;
  layout?: 'stacked' | 'split';
}

const { eyebrow, heading, paragraphs, image, ratio, alt, layout = 'stacked' } = Astro.props;
---

<section class="research-framework" data-layout={layout}>
  <div class="research-framework__intro">
    {eyebrow && <p class="research-framework__eyebrow">{eyebrow}</p>}
    <h2 class="research-framework__heading">{heading}</h2>
    {paragraphs.map((paragraph) => <p class="research-framework__body">{paragraph}</p>)}
  </div>
  <div class="research-framework__media">
    <Media fit="natural" image={image} ratio={ratio} alt={alt} />
  </div>
</section>

<style>
  /*
    容器已統一寬度讓左緣對齊，但整段跑到 1040px 寬一行會太長不好讀。
    這裡只收窄「文字本身」且靠左，不用 margin auto 置中——置中會讓左緣
    又跑掉，等於白對齊。
  */
  .reading-measure {
    max-width: 65ch;
  }

  /* split：文字在左、圖片在右；768 以下落回單欄 */
  .research-framework[data-layout='split'] {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--sp-5);
  }

  @media (max-width: 767px) {
    .research-framework[data-layout='split'] {
      grid-template-columns: 1fr;
    }
  }

  .research-framework {
    max-width: var(--project-width);
    margin: 0 auto;
    padding: var(--sp-6) var(--sp-3);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .research-framework__intro {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: var(--project-width);
  }

  .research-framework__eyebrow {
    font-size: var(--font-size-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .research-framework__body {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-muted);
    text-align: left;
  }
</style>
