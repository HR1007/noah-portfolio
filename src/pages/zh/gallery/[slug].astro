---
import { getEntry } from 'astro:content';
import GalleryAlbum from '../../../views/GalleryAlbum.astro';

export async function getStaticPaths() {
  const site = await getEntry('site', 'main-zh');
  const { albums, germany } = site!.data.gallery;
  return [...albums, germany].map((album) => ({
    params: { slug: album.slug },
    props: { slug: album.slug, title: album.title },
  }));
}

const { slug, title } = Astro.props;
---

<GalleryAlbum locale="zh" slug={slug} title={title} />
