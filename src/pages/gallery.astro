---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Media from '../components/Media.astro';
import { getGalleryImages } from '../lib/media';

const site = await getEntry('site', 'main');
const { eyebrow, headline, intro } = site!.data.gallery;

const images = getGalleryImages();
const placeholderCount = 9;
const items = images.length > 0 ? images : Array.from({ length: placeholderCount }, () => undefined);
---

<BaseLayout title={`${headline} — Noah Wen`} description={intro}>
  <section class="gallery">
    <SectionIntro eyebrow={eyebrow} headline={headline} body={intro} />
    <div class="gallery__grid">
      {
        items.map((image, index) => (
          <div class="gallery__item">
            <Media image={image} ratio="3/4" alt={`photo ${String(index + 1).padStart(2, '0')}`} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .gallery {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-3);
  }

  .gallery__grid {
    columns: 3;
    column-gap: var(--sp-2);
  }

  .gallery__item {
    break-inside: avoid;
    margin-bottom: var(--sp-2);
  }

  @media (max-width: 767px) {
    .gallery__grid {
      columns: 1;
    }
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .gallery__grid {
      columns: 2;
    }
  }
</style>
