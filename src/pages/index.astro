---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Media from '../components/Media.astro';
import PullQuote from '../components/PullQuote.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import ConnectChannel from '../components/ConnectChannel.astro';
import { getHomeImage } from '../lib/media';

const site = await getEntry('site', 'main');
const { home } = site!.data;

const heroImage = getHomeImage('hero');
const aboutImage = getHomeImage('about');
const beyondGridPhoto = getHomeImage('beyond-grid');
---

<BaseLayout
  title={`${home.heroName} — ${home.heroRoles[0]}`}
  description={home.aboutIntro}
>
  <section class="hero">
    <div class="hero__media">
      <Media image={heroImage} ratio="4/5" alt={`${home.heroName} pixel-art portrait`} />
    </div>
    <div class="hero__content">
      <h1 class="hero__name">{home.heroName}</h1>
      <p class="hero__tagline">{home.heroTagline}</p>
      <ul class="hero__roles">
        {home.heroRoles.map((role) => <li>{role}</li>)}
      </ul>
      <PullQuote quote={home.heroQuote} />
    </div>
  </section>

  <section class="about">
    <p class="about__eyebrow">{home.aboutEyebrow}</p>
    <h2 class="about__headline">{home.aboutHeadline}</h2>
    <div class="about__grid">
      <Media image={aboutImage} ratio="3/4" alt={home.heroName} />
      <p class="about__intro">{home.aboutIntro}</p>
    </div>
  </section>

  <section class="beyond-grid">
    <h2>{home.beyondGridHeading}</h2>
    <div class="beyond-grid__grid">
      <div class="beyond-grid__text">
        {home.beyondGridParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <Media image={beyondGridPhoto} ratio="16/9" alt={home.beyondGridHeading} />
    </div>
  </section>

  <section class="experience">
    {home.experience.map((item) => (
      <ExperienceItem title={item.title} period={item.period} description={item.description} />
    ))}
  </section>

  <section class="connect">
    <h2>{home.connectHeading}</h2>
    <div class="connect__intro">
      {home.connectIntro.map((line) => <p>{line}</p>)}
    </div>
    <div class="connect__channels">
      {home.connectChannels.map((channel) => (
        <ConnectChannel
          icon={channel.label.toLowerCase() === 'email' ? 'email' : 'instagram'}
          label={channel.label}
          value={channel.value}
          href={channel.href}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  section {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--sp-7) var(--sp-3);
  }

  .hero {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: var(--sp-6);
    align-items: center;
  }

  .hero__name {
    font-size: var(--font-size-h1);
  }

  .hero__tagline {
    color: var(--color-muted);
    font-size: var(--font-size-body);
    margin-top: var(--sp-1);
  }

  .hero__roles {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin: var(--sp-3) 0;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-body-lg);
  }

  .hero__roles li {
    list-style: disc;
    margin-left: 1.2em;
  }

  .about__eyebrow {
    font-size: var(--font-size-label);
    color: var(--color-muted);
    margin-bottom: var(--sp-1);
  }

  .about__headline {
    font-size: var(--font-size-h1);
    margin-bottom: var(--sp-4);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--sp-5);
    align-items: start;
  }

  .about__intro {
    font-size: var(--font-size-body);
    line-height: 1.7;
    color: var(--color-ink);
  }

  .beyond-grid {
    border-top: 1px solid var(--color-border);
  }

  .beyond-grid h2 {
    margin-bottom: var(--sp-3);
  }

  .beyond-grid__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: center;
  }

  .beyond-grid__text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    color: var(--color-muted);
    font-size: var(--font-size-body);
    line-height: 1.7;
  }

  .connect {
    text-align: center;
  }

  .connect h2 {
    margin-bottom: var(--sp-2);
  }

  .connect__intro {
    color: var(--color-muted);
    margin-bottom: var(--sp-4);
  }

  .connect__channels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-2);
    text-align: left;
    max-width: 560px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .hero,
    .about__grid,
    .beyond-grid__grid,
    .connect__channels {
      grid-template-columns: 1fr;
    }
  }
</style>
