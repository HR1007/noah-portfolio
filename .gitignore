# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# reference screenshots / raw exports, never shipped
raw-assets/
.vercel

# 產生的進度報告（由 npm run report 重建，不進版控）
.report/

# Claude Code 的本機設定與快取，整個目錄都不進版控。
# 目錄必須留在專案根目錄（Claude Code 從這裡讀取），只是不追蹤內容。
.claude/

# 後台「復原上一步」的快照，只是本機暫存
.admin-undo/

# DesignAgent 丟給 Figma 用的中介 HTML，每跑一次就多一個檔。
# 網站不依賴它們（在 src/ 與 public/ 之外，Astro 不會 build），
# 留著只會把發布面板的檔案清單塞滿雜訊——那份清單是發布前唯一的人工檢查。
.designagent-tmp/
